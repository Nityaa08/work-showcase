---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Meta from '../../components/Meta.astro';
import CaseNav from '../../components/CaseNav.astro';
import Glance from '../../components/Glance.astro';
import Lessons from '../../components/Lessons.astro';
import Stage from '../../components/Stage.astro';
import StagePlayer from '../../components/StagePlayer.astro';
import { cases } from '../../data/cases';
import { intro, sweepText, layers, attacks, findings, table, principles, sweep } from '../../data/security';

const c = cases.find((x) => x.slug === 'security')!;

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title} · Nityashree S</title>
    <meta name="description" content={c.intro} />
    <Meta title={`${c.title} · Nityashree S`} description={c.intro} path={`/work/${c.slug}/`} />
  </head>
  <body class="studio sec">
    <Nav crumb={`Case ${c.no}`} active="work" />
    <main>
      <section class="sx-hero">
        <div class="sx-head">
          <p class="kicker">Case {c.no}</p>
          <h1>{c.title}</h1>
          <p class="cs-intro">{intro}</p>
        </div>
        <div class="stack" id="stack">
          <div class="attack" id="attack"><span class="a-tag">attack</span><span id="a-text"></span></div>
          {layers.map(([n, d], i) => (
            <div class="layer" data-l={i}>
              <span class="l-no">0{i + 1}</span>
              <b>{n}</b>
              <span class="l-d">{d}</span>
              <span class="stamp-b"><i>blocked</i><em data-stop={i}></em></span>
            </div>
          ))}
          <p class="sx-count" aria-live="off"><b id="sx-n">1 / {attacks.length}</b><span>One attack per layer, on a loop</span></p>
        </div>
      </section>
      {c.glance && <section class="glance-sec"><Glance items={c.glance} /></section>}

      <section class="mx-sec">
        <div class="story-head"><p class="kicker">Attacks stopped</p><h2>Replay the attack. Watch it fail.</h2></div>
        <div class="fx-table-wrap">
          <table class="fx-table">
            <caption>Every finding at a glance</caption>
            <thead><tr><th scope="col">Layer</th><th scope="col">Attack</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
            <tbody>
              {table.map((r) => <tr><td class="fx-l">{r.layer}</td><td class="fx-a">{r.attack}</td><td class="fx-b">{r.before}</td><td class="fx-n">{r.after}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="fd-hint"><span class="fd-hint-ic" aria-hidden="true">▶</span>Pick any row to replay that attack in the terminal. It moves to the next one by itself.</p>
        <div class="replay">
          <ol class="findings" role="tablist">
            {findings.map((f, i) => (
              <li><button type="button" class:list={['fd', { on: i === 0 }]} data-i={i} aria-label={`Replay ${f.id}`}>
                <span class="fd-st">closed</span><span class="fd-layer">{f.layer}</span><span class="fd-id">{f.id}</span>
                <span class="fd-go" aria-hidden="true"><span class="fd-now">replaying</span><span class="fd-play">▶ replay</span></span>
                <span class="fd-txt">{f.risk} <em>→ {f.fix}</em></span>
                <span class="fd-bar" aria-hidden="true"><i /></span>
              </button></li>
            ))}
          </ol>
          <div class="replay-stage">
            {findings.map((f, i) => (
              <div class:list={['desk-slot', { active: i === 0 }]} data-slot={i}>
                <Stage stage={{ medium: 'shell', label: `replay · ${f.id}`, lines: f.lines }} />
              </div>
            ))}
          </div>
        </div>
      </section>


      <section class="mx-sec mx-split">
        <div>
          <div class="story-head"><p class="kicker">The sweep</p><h2>Find it, fix it, prove it’s gone.</h2></div>
          <p class="mx-lede">{sweepText}</p>
        </div>
        <Stage stage={sweep} />
      </section>

      <Lessons items={principles.map(([h, d]) => [h.replace(/\.$/, ''), d] as [string, string])} />
      <CaseNav slug={c.slug} />
    </main>
    <StagePlayer />
    <script>
      const fds = [...document.querySelectorAll<HTMLButtonElement>('.fd')];
      const slots = [...document.querySelectorAll<HTMLElement>('.replay-stage [data-slot]')];
      let cur = 0, timer = 0;
      const STEP = 6500;
      document.documentElement.style.setProperty('--fd-step', `${STEP}ms`);
      function pick(n: number) {
        cur = n;
        fds.forEach((f, k) => { f.classList.remove('run'); f.classList.toggle('on', k === n); f.setAttribute('aria-pressed', String(k === n)); });
        void fds[n].offsetWidth; fds[n].classList.add('run'); // restart the progress bar on the active row
        slots.forEach((s, k) => s.classList.toggle('active', k === n));
        dispatchEvent(new CustomEvent('slot:active', { detail: slots[n] }));
        clearTimeout(timer);
        timer = window.setTimeout(() => pick((cur + 1) % fds.length), STEP);
      }
      fds.forEach((f, k) => f.addEventListener('click', () => pick(k)));
      new IntersectionObserver(([e]) => { if (e.isIntersecting) pick(cur); else clearTimeout(timer); }, { threshold: 0.3 }).observe(document.querySelector('.replay')!);
    </script>
    <script define:vars={{ attacks }}>
      const stack = document.getElementById('stack');
      const atk = document.getElementById('attack');
      const atext = document.getElementById('a-text');
      const layersEl = [...document.querySelectorAll('.layer')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let k = 0;
      const count = document.getElementById('sx-n');
      function run() {
        const a = attacks[k % attacks.length];
        count.textContent = `${(k % attacks.length) + 1} / ${attacks.length}`;
        const target = layersEl[a.layer];
        layersEl.forEach((l) => l.classList.remove('hit', 'pass'));
        atk.classList.remove('drop', 'stopped');
        atk.classList.add('reset');
        atk.style.transform = 'translateY(0)';
        atext.textContent = a.try;
        void atk.offsetWidth;
        atk.classList.remove('reset');
        setTimeout(() => {
          atk.classList.add('drop');
          atk.style.transform = `translateY(${target.offsetTop - atk.offsetHeight - 8}px)`;
          layersEl.slice(0, a.layer).forEach((l, i) => setTimeout(() => l.classList.add('pass'), 110 * (i + 1)));
        }, 450);
        setTimeout(() => {
          target.querySelector('[data-stop]').textContent = a.stop;
          target.classList.add('hit');
          atk.classList.add('stopped');
        }, 1250);
        k++;
      }
      if (reduced) { count.textContent = `${attacks.length} layers`; layersEl.forEach((l, i) => { l.querySelector('[data-stop]').textContent = attacks[i].stop; l.classList.add('hit'); }); atk.style.display = 'none'; }
      else {
        let t = 0;
        const start = () => { if (!t) { run(); t = setInterval(run, 4600); } };
        const stop = () => { clearInterval(t); t = 0; };
        new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(stack);
      }
    </script>
  </body>
</html>
