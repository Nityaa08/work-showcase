---
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Meta from '../../components/Meta.astro';
import CaseNav from '../../components/CaseNav.astro';
import CaseTalk from '../../components/CaseTalk.astro';
import Glance from '../../components/Glance.astro';
import Lessons from '../../components/Lessons.astro';
import Stage from '../../components/Stage.astro';
import StagePlayer from '../../components/StagePlayer.astro';
import { cases } from '../../data/cases';
import { intro, sweepText, layers, attacks, findings, table, principles, sweep } from '../../data/security';

const c = cases.find((x) => x.slug === 'security')!;
// The hero opens on a finished example (it also stands without JavaScript), then plays the others in turn.
const first = attacks.findIndex((a) => a.layer === 2);

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title} · Nityashree S</title>
    <meta name="description" content={c.intro} />
    <Meta title={`${c.title} · Nityashree S`} description={c.intro} path={`/work/${c.slug}/`} />
  </head>
  <body class="studio sec">
    <Nav crumb={`Case ${c.no}`} active="work" />
    <main id="main" tabindex="-1">
      <section class="sx-hero">
        <div class="sx-head">
          <a class="cs-back" href="/#work"><span aria-hidden="true">←</span> All work</a>
          <p class="kicker">Case {c.no}</p>
          <h1>{c.title}</h1>
          {c.changed && <p class="cs-changed"><b>What changed</b> {c.changed}</p>}
          <p class="cs-intro">{intro}</p>
        </div>
        <div class="stack" id="stack" data-k={first}>
          <p class="attack" id="attack"><span class="a-tag">attack</span><span class="a-text" id="a-text">{attacks[first].try}</span></p>
          <div class="a-rail" aria-hidden="true"><i class="a-track"></i><i class="a-trail"></i><i class="a-dot"></i></div>
          {layers.map(([n, d], i) => (
            <div class:list={['layer', { pass: i < attacks[first].layer, hit: i === attacks[first].layer }]} data-l={i}>
              <span class="l-no">0{i + 1}</span>
              <b>{n}</b>
              <span class="l-d">{d}</span>
              <span class="stamp-b"><i>blocked</i><em data-stop={i}>{i === attacks[first].layer ? attacks[first].stop : ''}</em></span>
            </div>
          ))}
        </div>
      </section>
      {c.glance && <section class="glance-sec"><Glance items={c.glance} /></section>}

      <section class="mx-sec">
        <div class="story-head"><p class="kicker">Attacks stopped</p><h2>Replay the attack. Watch it fail.</h2></div>
        <p class="fd-hint">Each row is an attack I closed. Pick one to replay it: the attack, what happened before, and what happens now.</p>
        <div class="replay">
          <ol class="findings" aria-label="Findings">
            {table.map((r, i) => (
              <li><button type="button" class:list={['fd', { on: i === 0 }]} data-i={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="replay-stage">
                <span class="fd-st">closed</span><span class="fd-layer">{r.layer}</span><span class="fd-id">{r.attack}</span>
                <span class="fd-go" aria-hidden="true"><svg class="fd-ic-play" width="10" height="10" viewBox="0 0 10 10"><path d="M2.5 1.5v7l6-3.5z" fill="currentColor" /></svg><svg class="fd-ic-on" width="12" height="10" viewBox="0 0 12 10"><rect x="1" y="3" width="2" height="6" rx="1" /><rect x="5" y="1" width="2" height="8" rx="1" /><rect x="9" y="4" width="2" height="5" rx="1" /></svg></span>
                <span class="fd-txt"><em>Fix:</em> {findings[i].fix}</span>
                <span class="sr-only">Before: {r.before}. Now: {r.after}. Replay this attack.</span>
                <span class="fd-bar" aria-hidden="true"><i /></span>
              </button></li>
            ))}
          </ol>
          <div class="replay-stage" id="replay-stage">
            {findings.map((f, i) => (
              <div class:list={['desk-slot', { active: i === 0 }]} data-slot={i}>
                <Stage stage={{ medium: 'shell', label: `replay · ${f.id}`, lines: f.lines }} />
              </div>
            ))}
          </div>
        </div>
      </section>


      <section class="mx-sec mx-split">
        <div>
          <div class="story-head"><p class="kicker">The sweep</p><h2>Find it, fix it, prove it’s gone.</h2></div>
          <p class="mx-lede">{sweepText}</p>
        </div>
        <Stage stage={sweep} />
      </section>

      <Lessons items={principles.map(([h, d]) => [h.replace(/\.$/, ''), d] as [string, string])} />
      <CaseNav slug={c.slug} />
      <CaseTalk />
    </main>
    <StagePlayer />
    <script>
      const fds = [...document.querySelectorAll<HTMLButtonElement>('.fd')];
      const slots = [...document.querySelectorAll<HTMLElement>('.replay-stage [data-slot]')];
      let cur = 0, timer = 0;
      const STEP = 6500;
      document.documentElement.style.setProperty('--fd-step', `${STEP}ms`);
      function pick(n: number) {
        cur = n;
        fds.forEach((f, k) => { f.classList.remove('run'); f.classList.toggle('on', k === n); f.setAttribute('aria-pressed', String(k === n)); });
        void fds[n].offsetWidth; fds[n].classList.add('run'); // restart the progress bar on the active row
        slots.forEach((s, k) => s.classList.toggle('active', k === n));
        dispatchEvent(new CustomEvent('slot:active', { detail: slots[n] }));
        clearTimeout(timer);
        timer = window.setTimeout(() => pick((cur + 1) % fds.length), STEP);
      }
      fds.forEach((f, k) => f.addEventListener('click', () => pick(k)));
      new IntersectionObserver(([e]) => { if (e.isIntersecting) pick(cur); else clearTimeout(timer); }, { threshold: 0.3 }).observe(document.querySelector('.replay')!);
    </script>
    <script define:vars={{ attacks }}>
      // Case 03 hero: name the attack in the caption, step a red marker down the layers it gets through,
      // light the layer that stops it with its reason, hold so it can be read, then move to the next attack.
      const stack = document.getElementById('stack');
      const atext = document.getElementById('a-text');
      const layersEl = [...stack.querySelectorAll('.layer')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const css = getComputedStyle(document.documentElement);
      // the build may write 400ms as .4s, so read either unit
      const ms = (v) => { const x = css.getPropertyValue(v).trim(); return (parseFloat(x) * (/ms$/.test(x) ? 1 : 1000)) || 400; };
      const T = ms('--t-base');            // one fade or one step of travel
      const STEP = T + 160;                // time on each layer the attack gets through
      const READ = 900;                    // time to read the caption before the marker moves
      const HOLD = 2800;                   // the blocked state stays this long
      let k = Number(stack.dataset.k) || 0, pos = attacks[k].layer, timers = [], running = false;
      const later = (f, t) => timers.push(setTimeout(f, t));
      const clear = () => { timers.forEach(clearTimeout); timers = []; };
      stack.classList.add('js');

      // Marker and trail positions come from the layout, so they follow any screen size.
      function geometry() {
        const first = layersEl[0], last = layersEl[layersEl.length - 1];
        const top = first.offsetTop - 14;
        const centre = (i) => layersEl[i].offsetTop + layersEl[i].offsetHeight / 2;
        stack.style.setProperty('--rail-top', top + 'px');
        stack.style.setProperty('--rail-h', (last.offsetTop + last.offsetHeight - top) + 'px');
        return { top, len: last.offsetTop + last.offsetHeight - top, centre };
      }
      function place(i) {                  // i = -1 is the start, just under the caption
        const g = geometry();
        const y = i < 0 ? g.top : g.centre(i);
        stack.style.setProperty('--dot-y', (y - 5) + 'px');
        stack.style.setProperty('--trail', String(Math.max(0, y - g.top) / g.len));
        pos = i;
      }
      function snap(f) { stack.classList.add('snap'); f(); void stack.offsetWidth; stack.classList.remove('snap'); }
      function finalState(a) {
        layersEl.forEach((l, i) => { l.classList.remove('at'); l.classList.toggle('pass', i < a.layer); l.classList.toggle('hit', i === a.layer); });
        layersEl[a.layer].querySelector('[data-stop]').textContent = a.stop;
        atext.textContent = a.try;
        place(a.layer);
      }

      function play() {
        k = (k + 1) % attacks.length;
        const a = attacks[k];
        if (reduced) { snap(() => finalState(a)); later(play, HOLD + 2200); return; }
        // 1. fade the last attack out
        stack.classList.add('out');
        layersEl.forEach((l) => l.classList.remove('hit', 'pass', 'at'));
        later(() => {
          // 2. new caption in, marker back at the top
          atext.textContent = a.try;
          snap(() => place(-1));
          stack.classList.remove('out');
          // 3. step down: every layer it gets through keeps a red edge; the one that stops it lights green
          for (let i = 0; i <= a.layer; i++) {
            later(() => {
              if (i > 0) layersEl[i - 1].classList.remove('at');
              place(i);                    // travel to the layer, then mark it on arrival
              later(() => {
                if (i < a.layer) { layersEl[i].classList.add('pass', 'at'); return; }
                layersEl[i].querySelector('[data-stop]').textContent = a.stop;
                layersEl[i].classList.add('hit');
              }, T * 0.75);
            }, READ + i * STEP);
          }
          // 4. hold, then the next one
          later(play, READ + a.layer * STEP + T + HOLD);
        }, T);
      }

      snap(() => place(pos));
      const start = () => { if (!running) { running = true; later(play, HOLD); } };
      const stop = () => { running = false; clear(); snap(() => finalState(attacks[k])); stack.classList.remove('out'); };
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(stack);
      addEventListener('resize', () => snap(() => place(pos)));
    </script>
  </body>
</html>
