                  <text class:list={['crb-a', { 'crb-a-ink': m.fill === 'ink' }]} transform={`translate(${(m.x + m.w / 2).toFixed(1)} ${miniBooks.base - 8}) rotate(90)`} dy="0.35em" text-anchor="end">{m.name}</text>
                </g>
