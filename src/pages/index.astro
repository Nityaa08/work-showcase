              <span class="crc-tile crc-rt"><span class="crr"><i /><b /><i /></span><span class="crr on"><i /><b /><i /></span><span class="crr"><i /><b /><i /></span></span>
              <span class="crc-tile crc-fr">{[30, 42, 36, 50, 40, 96, 44, 38, 46].map((h, j) => <i class:list={{ spike: j === 5 }} style={`height:${h}%`} />)}</span>
            </span>
