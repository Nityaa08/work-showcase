---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import StagePlayer from '../components/StagePlayer.astro';
import Meta from '../components/Meta.astro';
import { cases } from '../data/cases';
import { hero, how, contact, path, cards, desk, outsideIntro, contactLine, letter, mailto } from '../data/home';
import Desk from '../components/Desk.astro';
// The envelope's stamp: a rectangle with a perforated (scalloped) edge, traced clockwise.
const stampEdge = (() => {
  const w = 60, h = 72, r = 2.4, n = [8, 10];
  let d = 'M0 0';
  const side = (len: number, cnt: number, dx: number, dy: number) => {
    const step = len / cnt, gap = (step - 2 * r) / 2;
    for (let i = 0; i < cnt; i++) d += ` l${dx * gap} ${dy * gap} a${r} ${r} 0 0 0 ${dx * 2 * r} ${dy * 2 * r} l${dx * gap} ${dy * gap}`;
  };
  side(w, n[0], 1, 0); side(h, n[1], 0, 1); side(w, n[0], -1, 0); side(h, n[1], 0, -1);
  return d + ' Z';
})();
const first = letter.topics[0];

const work = cases.filter((c) => c.ready);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nityashree S · AI engineer</title>
    <meta name="description" content="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
    <Meta title="Nityashree S · AI engineer" description="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
  </head>
  <body class="studio home" id="top">
    <Nav />
    <main>
      <section class="h-open light" data-light>
        <div class="h-open-text">
          <p class="h-hi">{hero.hi}</p>
          <h1>{hero.headline}</h1>
          <p class="h-sub">{hero.sub}</p>
          <div class="h-actions">
            <a class="h-resume" href={contact.resume} target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a>
            <a class="h-more" href="#work">See my work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="photo">
          <picture>
            <source srcset="/portrait-muted.webp" type="image/webp" />
            <img src="/portrait-muted.jpg" alt="Nityashree S, smiling" width="980" height="1220" fetchpriority="high" />
          </picture>
        </figure>
      </section>

      <section class="h-work" id="work">
        <div class="story-head"><h2>Selected work</h2></div>
        <div class="w-grid">
          {work.map((c) => (
            <a class="w-card" href={`/work/${c.slug}/`}>
              <div class:list={['w-art', `art-${c.slug}`]}>
                {c.slug === 'agent-platform' && (
                  <div class="mini-win"><i /><i /><i /><p class="r">turn failed · bad skill header</p><p class="r">turn failed · bad skill header</p><p class="g">fixed · agent answers again</p></div>
                )}
                {c.slug === 'mcp-connections' && (
                  <div class="mini-flow"><span>agent</span><b /><span>gateway</span><b /><span>connector</span><b /><span>app</span></div>
                )}
                {c.slug === 'security' && (
                  <div class="mini-stack"><i class="ms-trail" aria-hidden="true" />{['edge', 'identity', 'tenant', 'model', 'sandbox', 'dependencies'].map((l, i) => <span class:list={{ pass: i < 2, hit: i === 2 }}>{l}{i === 2 && <em>blocked</em>}</span>)}</div>
                )}
              </div>
              <div class="w-meta">
                <span class="w-no">Case {c.no}</span>
                <h3>{cards[c.slug].headline}</h3>
                <p><span class="w-topic">{c.title}.</span> {cards[c.slug].text}</p>
                <span class="w-go">Read the case study →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="h-how" id="how">
        <div class="how-text">
          <p class="kicker">How I work</p>
          <h2>One laptop, a team of agents,<br /> and me in the loop.</h2>
          <p>{how.text}</p>
          <ol class="how-steps">{how.steps.map((x) => <li>{x}</li>)}</ol>
          <p class="how-tools">{how.tools}</p>
        </div>
        <div class="how-phone"><Phone /></div>
      </section>

      <section class="h-path light" id="about" data-light>
        <p class="kicker">My path</p>
        <h2>From payments data to production AI.</h2>
        <ol class="path-steps">
          {path.map((p) => <li><span>{p.when}</span><h3>{p.title}</h3><p>{p.line}</p></li>)}
        </ol>
      </section>

      <section class="h-outside light" id="outside" data-light>
        <div class="ow-text">
          <p class="kicker">Outside work</p>
          <h2>{outsideIntro.title}</h2>
          <p class="ow-intro">{outsideIntro.text}</p>
        </div>
        <div class="ow-desk"><Desk /></div>
        <div class="ow-note">
          <p class="dk-hint" id="dk-hint"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v4.5A6.5 6.5 0 0 1 11.5 21h-.6a6 6 0 0 1-4.6-2.2L3.6 15.4a1.6 1.6 0 0 1 2.4-2.1L9 16" /></svg><span><b>{outsideIntro.hint}</b> {outsideIntro.hintSub}</span></p>
          <article class="dk-card" id="dk-card" tabindex="-1" hidden aria-labelledby="dk-name">
            <div class="dk-card-top">
              <h3 class="dk-name" id="dk-name"></h3>
              <button type="button" class="dk-close" aria-label="Close note"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
            </div>
            <p class="dk-text"></p>
            <a class="dk-ask" href="#contact"><span></span> <i aria-hidden="true">→</i></a>
          </article>
          <p class="sr-only" id="dk-live" aria-live="polite"></p>
          <template id="dk-notes">{desk.map((d) => <div data-k={d.id} data-name={d.name} data-note={d.note} data-ask={d.ask} />)}</template>
          <noscript>
            <style is:inline>.dk-hint { display: none !important; }</style>
            <ul class="dk-plain">{desk.map((d) => <li><b>{d.name}.</b> {d.note} {d.ask}</li>)}</ul>
          </noscript>
        </div>
      </section>

      <section class="h-contact light" id="contact" data-light>
        <div class="ct-left">
          <div class="ct-text">
            <p class="kicker">Contact</p>
            <h2>Let’s talk.</h2>
            <p class="ct-line">{contactLine}</p>
          </div>
          <div class="ct-act">
            <p class="ct-topics-l" id="ct-topics-l">{letter.topicsLabel}</p>
            <div class="ct-topics" role="group" aria-labelledby="ct-topics-l">
              {letter.topics.map((t) => <a class="ct-topic" href={mailto(t.subject, t.body)} data-label={t.label}>{t.label}</a>)}
            </div>
            <div class="ct-btns">
              <a class="ct-write" href={mailto(first.subject, first.body)} data-write><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg><span>{letter.write}</span></a>
              <button type="button" class="ct-copybtn" data-copy={contact.email} aria-label="Copy email address"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg><span>Copy email</span></button>
            </div>
            <p class="ct-cap">{letter.caption}</p>
            <p class="ct-fall" hidden>Didn’t open? Copy my email, or write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
            <p class="sr-only" id="ct-status" aria-live="polite"></p>
          </div>
        </div>
        <div class="ct-side">
          <div class="mail" data-mail role="img" aria-label={`A hand-drawn envelope addressed to Nitya, ${contact.email}`}>
            <div class="ml-tilt">
              <div class="ml-back"></div>
              <div class="ml-letter"><p class="ml-hi">Hi Nitya,</p><p class="ml-about">About: <b data-about>{first.label}</b></p><i></i><i></i><i></i></div>
              <div class="ml-front">
                <div class="ml-to"><span class="ml-k">To</span><span class="ml-name">Nitya</span><span class="ml-addr">{contact.email}</span></div>
                <span class="ml-air" aria-hidden="true"></span>
              </div>
              <div class="ml-flap"><svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0.8 40 L50 1 L99.2 40" /></svg></div>
              <svg class="ml-stamp" viewBox="-3 -3 66 78" aria-hidden="true">
                <path class="ml-stamp-edge" d={stampEdge} />
                <rect class="ml-stamp-in" x="7" y="7" width="46" height="58" rx="2" />
                <text class="ml-ns" x="30" y="43" text-anchor="middle">NS</text>
                <path class="ml-stamp-mic" d="M24 54 h12" />
              </svg>
              <svg class="ml-mark" viewBox="0 0 110 60" aria-hidden="true">
                <defs><path id="ml-arc" d="M11.8 40.5 A21 21 0 1 1 48.2 40.5" /></defs>
                <circle cx="30" cy="30" r="27" /><circle cx="30" cy="30" r="15" />
                <text><textPath href="#ml-arc" startOffset="50%" text-anchor="middle">SENT WITH CARE</textPath></text>
                <path class="ml-heart" d="M30 38 C24 34 23.5 29.5 26.5 28.6 C28 28.2 29.4 29.2 30 30.4 C30.6 29.2 32 28.2 33.5 28.6 C36.5 29.5 36 34 30 38 Z" />
                <path class="ml-wave" d="M60 20 q6 -5 12 0 t12 0 t12 0 t12 0 M60 30 q6 -5 12 0 t12 0 t12 0 t12 0 M60 40 q6 -5 12 0 t12 0 t12 0 t12 0" />
              </svg>
              <span class="ml-copied" aria-hidden="true">Copied!</span>
            </div>
          </div>
          <ul class="ct-links">
            <li><a href={contact.linkedin} target="_blank" rel="noopener"><svg class="ct-ic" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg><span>LinkedIn</span><i aria-hidden="true">↗</i></a></li>
            <li><a href={contact.github} target="_blank" rel="noopener"><svg class="ct-ic" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z" /></svg><span>GitHub</span><i aria-hidden="true">↗</i></a></li>
            <li><a href={contact.resume} target="_blank" rel="noopener"><svg class="ct-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg><span>Resume <small>PDF</small></span><i aria-hidden="true">↓</i></a></li>
          </ul>
        </div>
        <noscript><style is:inline>.ct-copybtn { display: none !important; }</style></noscript>
      </section>
    </main>
    <footer class="foot light" data-light>
      <span>© Nityashree S</span>
      <span class="foot-sig">Made with care. No prompts injected.</span>
      <a href="#top">Back to top ↑</a>
    </footer>
    <StagePlayer />
    <script>
      // Nav switches to its light style while it sits over a light section.
      const navEl = document.getElementById('nav')!;
      const lights = [...document.querySelectorAll<HTMLElement>('[data-light]')];
      const paint = () => { const y = 34; navEl.classList.toggle('on-light', lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= y && r.bottom > y; })); };
      paint(); addEventListener('scroll', paint, { passive: true }); addEventListener('resize', paint);
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const wait = (ms: number) => new Promise((r) => setTimeout(r, still.matches ? 0 : ms));

      // --- The desk: every object is a button that opens one note at a time. ---
      const deskEl = document.querySelector<HTMLElement>('[data-desk]');
      if (deskEl) {
        // Idle motion only runs while the desk is on screen.
        new IntersectionObserver(([e]) => deskEl.classList.toggle('in', e.isIntersecting), { rootMargin: '60px 0px' }).observe(deskEl);
        const notes = new Map([...(document.getElementById('dk-notes') as HTMLTemplateElement).content.querySelectorAll<HTMLElement>('[data-k]')].map((n) => [n.dataset.k!, n.dataset]));
        const card = document.getElementById('dk-card')!, hint = document.getElementById('dk-hint')!, live = document.getElementById('dk-live')!;
        const btns = [...deskEl.querySelectorAll<HTMLButtonElement>('.dk-hit')];
        const objs = (k: string) => deskEl.querySelectorAll(`[data-obj="${k}"], [data-for="${k}"]`);
        const mark = (k: string, cls: string, on: boolean) => objs(k).forEach((o) => o.classList.toggle(cls, on));
        let open = '';
        const close = (focusBack = false) => {
          if (!open) return;
          const b = btns.find((x) => x.dataset.k === open)!;
          mark(open, 'open', false); b.setAttribute('aria-expanded', 'false');
          card.hidden = true; card.classList.remove('show'); hint.hidden = false; live.textContent = '';
          open = '';
          if (focusBack) b.focus();
        };
        const show = (k: string) => {
          close();
          const n = notes.get(k)!, b = btns.find((x) => x.dataset.k === k)!;
          open = k; mark(k, 'open', true); b.setAttribute('aria-expanded', 'true');
          card.dataset.k = k;
          card.querySelector('.dk-name')!.textContent = n.name!;
          card.querySelector('.dk-text')!.textContent = n.note!;
          card.querySelector('.dk-ask span')!.textContent = n.ask!;
          hint.hidden = true; card.hidden = false;
          // The globe's plane flies its route (SMIL); with motion off it simply lands.
          if (k === 'globe') { const fly = deskEl.querySelector<SVGAnimationElement>('.dk-plane animateMotion'); if (fly) { fly.setAttribute('dur', still.matches ? '0.01s' : '1.8s'); try { fly.beginElement(); } catch {} } }
          requestAnimationFrame(() => card.classList.add('show'));
          live.textContent = `${n.name}. ${n.note} ${n.ask}`;
          // On a phone the note sits under the drawing: bring it into view if it is below the fold.
          const r = card.getBoundingClientRect();
          if (r.bottom > innerHeight) card.scrollIntoView({ block: 'nearest', behavior: still.matches ? 'auto' : 'smooth' });
        };
        btns.forEach((b) => {
          const k = b.dataset.k!;
          b.addEventListener('pointerenter', () => mark(k, 'hot', true));
          b.addEventListener('pointerleave', () => mark(k, 'hot', false));
          b.addEventListener('focus', () => b.matches(':focus-visible') && mark(k, 'hot', true));
          b.addEventListener('blur', () => mark(k, 'hot', false));
          b.addEventListener('click', () => (open === k ? close() : show(k)));
        });
        card.querySelector('.dk-close')!.addEventListener('click', () => close(true));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) close(true); });
      }

      // --- Contact: a hand-drawn envelope. "Write to me" tucks the letter in, closes the flap, postmarks
      // the stamp, then opens the visitor's own email app. Nothing is sent anywhere. Without JS all are plain links.
      const mail = document.querySelector<HTMLElement>('[data-mail]');
      const write = document.querySelector<HTMLAnchorElement>('[data-write]');
      const status = document.getElementById('ct-status');
      if (mail && write) {
        const about = mail.querySelector<HTMLElement>('[data-about]')!;
        const topics = [...document.querySelectorAll<HTMLAnchorElement>('.ct-topic')];
        const fall = document.querySelector<HTMLElement>('.ct-fall');
        mail.classList.add('js');
        // The letter rises out of the envelope the first time it scrolls into view.
        new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); mail.classList.add('in'); } }, { threshold: 0.3 }).observe(mail);
        // Topics: pick one and the letter (and the email subject) follow it.
        const pick = (t: HTMLAnchorElement) => {
          topics.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
          write.href = t.href;
          if (about.textContent !== t.dataset.label) {
            about.textContent = t.dataset.label!;
            about.classList.remove('swap'); void about.offsetWidth; about.classList.add('swap');
          }
          if (status) status.textContent = `Topic: ${t.dataset.label}.`;
        };
        topics.forEach((t, i) => {
          t.setAttribute('role', 'button'); t.setAttribute('aria-pressed', String(i === 0));
          t.addEventListener('click', (e) => { e.preventDefault(); pick(t); });
          t.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); pick(t); } });
        });
        // Pointing at the button (or the envelope) lifts the envelope a little.
        const hot = (on: boolean) => mail.classList.toggle('hot', on);
        write.addEventListener('pointerenter', () => hot(true)); write.addEventListener('pointerleave', () => hot(false));
        write.addEventListener('focus', () => hot(true)); write.addEventListener('blur', () => hot(false));
        mail.addEventListener('click', () => write.click());
        let busy = false;
        const go = () => { write.dataset.go = '1'; write.click(); if (fall) fall.hidden = false; if (status) status.textContent = 'Opening your email app.'; };
        write.addEventListener('click', async (e) => {
          if (write.dataset.go) { delete write.dataset.go; return; } // second pass: let the mailto link open
          e.preventDefault();
          if (busy) return; busy = true;
          mail.classList.add('in'); mail.classList.remove('stamped'); void mail.offsetWidth;
          if (still.matches) { mail.classList.add('stamped'); go(); busy = false; return; }
          mail.classList.add('send');
          await wait(950); mail.classList.add('stamped');
          await wait(650); go();
          await wait(1500); mail.classList.remove('send'); hot(false);
          await wait(900); busy = false;
        });
      }

      // Copy email, with a playful "Copied!" stamp on the envelope.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
        const label = b.querySelector('span')!, html = label.innerHTML;
        let t = 0;
        b.addEventListener('click', async () => {
          const v = b.dataset.copy!;
          let ok = false;
          try { await navigator.clipboard.writeText(v); ok = true; } catch {
            const ta = document.createElement('textarea'); ta.value = v; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.append(ta); ta.select(); try { ok = document.execCommand('copy'); } catch {} ta.remove();
          }
          label.textContent = ok ? 'Copied' : 'Press Ctrl+C';
          b.classList.toggle('done', ok);
          if (status) status.textContent = ok ? 'Email address copied.' : `Copy didn’t work. The address is ${v}.`;
          if (mail) { mail.classList.remove('copied'); void mail.offsetWidth; if (ok) mail.classList.add('copied'); }
          if (!ok) { const m = document.querySelector('.ml-addr'); if (m) { const r = document.createRange(); r.selectNodeContents(m); getSelection()!.removeAllRanges(); getSelection()!.addRange(r); } }
          clearTimeout(t);
          t = window.setTimeout(() => { label.innerHTML = html; b.classList.remove('done'); mail?.classList.remove('copied'); }, 2000);
        });
      });
    </script>
  </body>
</html>
