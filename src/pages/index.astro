          </div>
          <p class="ct-hint" id="ct-hint" data-fallback={letter.fallback} hidden><span class="ct-hint-p">{letter.hint}</span><span class="ct-hint-t">{letter.hintTouch}</span></p>
          <ContactLinks />
        </div>
        <p class="sr-only" id="ct-status" role="status" aria-live="polite"></p>
      </section>
      </div>
    </main>
    <footer class="foot light" data-light>
      <span>© Nityashree S</span>
      <span class="foot-sig">Made with care. No prompts injected.</span>
      <a href="#top">Back to top ↑</a>
    </footer>
    <StagePlayer />
    <script>
      // Nav switches to its light style while it sits over a light section.
      const navEl = document.getElementById('nav')!;
      const lights = [...document.querySelectorAll<HTMLElement>('[data-light]')];
      // Read layout at most once per frame (rAF), never once per scroll event.
      let queued = false;
      const paint = () => { queued = false; const y = 34; navEl.classList.toggle('on-light', lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= y && r.bottom > y; })); };
      const queue = () => { if (!queued) { queued = true; requestAnimationFrame(paint); } };
      paint(); addEventListener('scroll', queue, { passive: true }); addEventListener('resize', queue);
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      // Looping decorations run only while they are on screen (the work card's flow line).
      const loopIO = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('in', e.isIntersecting)));
      document.querySelectorAll('.mini-flow').forEach((el) => loopIO.observe(el));
      // One-time entrances ([data-reveal] gets .in once, as it comes into view; at once with motion off). My path's
      // trail also pauses its entrance while it is off screen (.off).
      const reveals = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (still.matches) reveals.forEach((el) => el.classList.add('in'));
      else {
        // When every animation of an entrance has finished, mark it .done so the browser can let go of their layers.
        const settle = (el: Element) => Promise.all(el.getAnimations({ subtree: true }).map((x) => x.finished)).then(() => el.classList.add('done'), () => {});
        const revealIO = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); settle(e.target); } }), { threshold: 0.3 });
        reveals.forEach((el) => revealIO.observe(el));
      }
      const liveIO = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('off', !e.isIntersecting)));
      document.querySelectorAll('.tr').forEach((el) => liveIO.observe(el));
      const wait = (ms: number) => new Promise((r) => setTimeout(r, still.matches ? 0 : ms));

      // --- The desk: every object is a button that opens one note at a time. ---
      // Round 25 (performance): one delegated listener per event type for the whole desk, all removable through one
      // AbortController; a new note replaces the old one at once (the old object snaps back, nothing is queued); and the
      // object whose reveal is playing sits on its own layer only for that time.
      const deskEl = document.querySelector<HTMLElement>('[data-desk]');
      if (deskEl) {
        const ac = new AbortController(), on = { signal: ac.signal }, passive = { signal: ac.signal, passive: true };
        // Idle motion only runs while the desk is on screen.
        const seen = new IntersectionObserver(([e]) => deskEl.classList.toggle('in', e.isIntersecting), { rootMargin: '60px 0px' });
        seen.observe(deskEl);
        // Cancel the page's laptop zoom inside the desk (see .dk-in in global.css): the browser multiplies zooms in
        // single-precision floats, so pick the inverse whose product is exactly 1, or Chrome still treats it as zoomed.
        const dkIn = deskEl.querySelector<HTMLElement>('.dk-in')!;
        const unzoom = () => {
          const z = Math.fround(parseFloat(getComputedStyle(document.documentElement).zoom) || 1);
          let c = 1 / z;
          for (let i = 1; Math.fround(z * Math.fround(c)) !== 1 && i < 600; i++) c = 1 / z + (i % 2 ? 1 : -1) * Math.ceil(i / 2) * 1e-8;
          dkIn.style.zoom = z === 1 ? '' : c.toFixed(8);
          dkIn.classList.toggle('unz', z !== 1);
          return z;
        };
        // Strokes keep their on-screen width at every desk size: --u is drawing units per CSS pixel (see global.css).
        // The strokes were drawn at 1.5px times the page zoom, so they stay that thick.
        const sized = new ResizeObserver(([e]) => { const z = unzoom(), w = e.contentRect.width; if (w > 0) deskEl.style.setProperty('--u', ((600 * z) / w).toFixed(4)); });
        unzoom(); sized.observe(dkIn);
        addEventListener('pagehide', (e) => { if (!e.persisted) { ac.abort(); seen.disconnect(); sized.disconnect(); } }, { once: true });
        // While the page scrolls, the pointer sweeping over the drawing must not start hover animations (Safari updates
        // hover mid-scroll). The hit areas ignore the pointer until scrolling has stopped for a moment.
        let rest = 0;
        addEventListener('scroll', () => {
          if (!deskEl.classList.contains('in')) return;
          if (!deskEl.classList.contains('busy')) { deskEl.classList.add('busy'); setHot(''); }
          clearTimeout(rest); rest = window.setTimeout(() => deskEl.classList.remove('busy'), 180);
        }, passive);
        const notes = new Map([...(document.getElementById('dk-notes') as HTMLTemplateElement).content.querySelectorAll<HTMLElement>('[data-k]')].map((n) => [n.dataset.k!, n.dataset]));
        const card = document.getElementById('dk-card')!, hint = document.getElementById('dk-hint')!, live = document.getElementById('dk-live')!;
        const nameEl = card.querySelector('.dk-name')!, textEl = card.querySelector('.dk-text')!;
        const linkEl = document.getElementById('dk-link') as HTMLAnchorElement, linkText = linkEl.querySelector('span')!;
        const btns = new Map([...deskEl.querySelectorAll<HTMLButtonElement>('.dk-hit')].map((b) => [b.dataset.k!, b]));
        // Every element that belongs to an object, looked up once: its drawing, its piece (the small SVG it lives in)
        // and, for the mug and the mic, the steam and the spotlight.
        const parts = new Map([...btns.keys()].map((k) => [k, [...deskEl.querySelectorAll<Element>(`[data-obj="${k}"], [data-for="${k}"]`)]]));
        const pieces = new Map([...btns.keys()].map((k) => [k, [...deskEl.querySelectorAll<Element>(`[data-pc="${k}"]`)]]));
        const fly = deskEl.querySelector<SVGAnimationElement>('.dk-plane animateMotion');
        const mark = (k: string, cls: string, v: boolean) => parts.get(k)!.forEach((o) => o.classList.toggle(cls, v));
        let open = '', seq = 0, hot = '', swapT = 0, runT = 0, runK = '';
        // Lift the object's piece onto its own layer while its reveal plays (about three seconds), then drop it.
        const run = (k: string) => {
          clearTimeout(runT); if (runK) pieces.get(runK)!.forEach((p) => p.classList.remove('run'));
          runK = still.matches ? '' : k; if (!runK) return;
          pieces.get(k)!.forEach((p) => p.classList.add('run'));
          runT = window.setTimeout(() => { pieces.get(k)!.forEach((p) => p.classList.remove('run')); runK = ''; }, 3200);
        };
        // An object that loses its note goes straight back to rest: no reverse transitions running beside the new reveal.
        const snap = (k: string) => {
          const els = parts.get(k)!; els.forEach((o) => o.classList.add('dk-snap'));
          mark(k, 'open', false);
          requestAnimationFrame(() => requestAnimationFrame(() => els.forEach((o) => o.classList.remove('dk-snap'))));
        };
        const setText = (k: string) => {
          const n = notes.get(k)!; nameEl.textContent = n.name!; textEl.textContent = n.note!;
          // A note can lead somewhere (the books open my shelf, the laptop My corner).
          linkEl.hidden = !n.href; if (n.href) { linkEl.href = n.href; linkText.textContent = n.link!; }
        };
        const close = (focusBack = false) => {
          if (!open) return;
          const b = btns.get(open)!;
          snap(open); b.setAttribute('aria-expanded', 'false'); run('');
          seq++; clearTimeout(swapT); card.classList.remove('show', 'swap'); card.hidden = true; hint.hidden = false; live.textContent = '';
          open = '';
          if (focusBack) b.focus();
        };
        const show = (k: string) => {
          const n = notes.get(k)!, was = open, my = ++seq;
          if (was) { snap(was); btns.get(was)!.setAttribute('aria-expanded', 'false'); }
          open = k; mark(k, 'open', true); btns.get(k)!.setAttribute('aria-expanded', 'true'); run(k);
          card.dataset.k = k;
          clearTimeout(swapT);
          if (was && !card.hidden) {
            // Switching notes: the card stays put and only its words cross-fade. A newer click cancels this one.
            card.classList.add('swap');
            swapT = window.setTimeout(() => { if (my !== seq) return; setText(k); card.classList.remove('swap'); }, still.matches ? 0 : 180);
          } else {
            setText(k); card.classList.remove('show', 'swap');
            hint.hidden = true; card.hidden = false;
            requestAnimationFrame(() => requestAnimationFrame(() => { if (my === seq) card.classList.add('show'); }));
          }
          // The globe's plane flies its route (SMIL); with motion off it simply lands.
          if (k === 'globe' && fly) { fly.setAttribute('dur', still.matches ? '0.01s' : '2s'); try { fly.beginElement(); } catch {} }
          live.textContent = `${n.name}. ${n.note}`;
          // On a phone the note sits under the drawing: bring it into view if it is below the fold.
          const r = card.getBoundingClientRect();
          if (r.bottom > innerHeight) card.scrollIntoView({ block: 'nearest', behavior: still.matches ? 'auto' : 'smooth' });
        };
        const hitOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<HTMLButtonElement>('.dk-hit') : null);
        const setHot = (k: string) => { if (hot === k) return; if (hot) mark(hot, 'hot', false); hot = k; if (k) mark(k, 'hot', true); };
        deskEl.addEventListener('pointerover', (e) => { const b = hitOf(e.target); if (b) setHot(b.dataset.k!); }, on);
        deskEl.addEventListener('pointerout', (e) => { const b = hitOf(e.target); if (b && hitOf(e.relatedTarget) !== b) setHot(''); }, on);
        deskEl.addEventListener('focusin', (e) => { const b = hitOf(e.target); if (b && b.matches(':focus-visible')) setHot(b.dataset.k!); }, on);
        deskEl.addEventListener('focusout', (e) => { if (hitOf(e.target)) setHot(''); }, on);
        deskEl.addEventListener('click', (e) => { const b = hitOf(e.target); if (!b) return; const k = b.dataset.k!; open === k ? close() : show(k); }, on);
        card.querySelector('.dk-close')!.addEventListener('click', () => close(true), on);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) close(true); }, on);
      }

      // --- Contact: an envelope addressed to me. Clicking it (or the address) tucks the letter in, closes the flap,
      // postmarks the stamp, then opens the visitor's own email app. The icon beside the address copies it.
      // Nothing is sent anywhere. Without JavaScript the address is a plain email link.
      const mail = document.querySelector<HTMLElement>('[data-mail]');
      const addr = document.querySelector<HTMLAnchorElement>('[data-write]');
      const status = document.getElementById('ct-status');
      const ctHint = document.getElementById('ct-hint');
      const copyBtn = document.querySelector<HTMLButtonElement>('.ml-copy');
      if (mail && addr) {
        mail.classList.add('js');
        if (ctHint) ctHint.hidden = false;
        if (copyBtn) copyBtn.hidden = false;
        // The letter peeks out of the envelope the first time it scrolls into view.
        new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); mail.classList.add('in'); } }, { threshold: 0.3 }).observe(mail);
        addr.addEventListener('focus', () => addr.matches(':focus-visible') && mail.classList.add('hot'));
        addr.addEventListener('blur', () => mail.classList.remove('hot'));
        // The whole envelope is the button; the address link and the copy icon handle their own clicks.
        mail.addEventListener('click', (e) => { const t = e.target as Element; if (t.closest('.ml-copy, [data-write]')) return; addr.click(); });
        let busy = false;
        const go = () => {
          addr.dataset.go = '1'; addr.click();
          if (status) status.textContent = 'Opening your email app.';
          if (ctHint && ctHint.dataset.fallback) { ctHint.textContent = ctHint.dataset.fallback; ctHint.classList.add('after'); }
        };
        addr.addEventListener('click', async (e) => {
          if (addr.dataset.go) { delete addr.dataset.go; return; } // second pass: let the mailto link open
          e.preventDefault();
          if (busy) return; busy = true;
          mail.classList.add('in'); mail.classList.remove('stamped', 'copied'); void mail.offsetWidth;
          // go() runs on the next tick: a nested click on the same link would be ignored while this one is in progress.
          if (still.matches) { mail.classList.add('stamped'); window.setTimeout(() => { go(); busy = false; }, 0); return; }
          mail.classList.add('send');
          await wait(950); mail.classList.add('stamped');
          await wait(650); go();
          await wait(1500); mail.classList.remove('send');
          await wait(900); busy = false;
        });
        // Copy: the icon turns into a tick and a "Copied" stamp lands on the envelope.
        if (copyBtn) {
          let t = 0;
          copyBtn.addEventListener('click', async () => {
            const v = copyBtn.dataset.copy!;
            let ok = false;
            try { await navigator.clipboard.writeText(v); ok = true; } catch {
              const ta = document.createElement('textarea'); ta.value = v; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.append(ta); ta.select(); try { ok = document.execCommand('copy'); } catch {} ta.remove();
            }
            copyBtn.classList.toggle('done', ok);
            copyBtn.setAttribute('aria-label', ok ? 'Copied' : 'Copy my email address');
            if (status) status.textContent = ok ? 'Email address copied.' : `Copy didn’t work. The address is selected: ${v}.`;
            mail.classList.remove('copied'); void mail.offsetWidth; if (ok) mail.classList.add('copied');
            if (!ok) { const r = document.createRange(); r.selectNodeContents(addr); getSelection()!.removeAllRanges(); getSelection()!.addRange(r); }
            clearTimeout(t);
            t = window.setTimeout(() => { copyBtn.classList.remove('done'); copyBtn.setAttribute('aria-label', 'Copy my email address'); mail.classList.remove('copied'); }, 2000);
          });
        }
      }
    </script>
  </body>
</html>
