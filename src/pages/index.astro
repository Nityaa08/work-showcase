---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import StagePlayer from '../components/StagePlayer.astro';
import Meta from '../components/Meta.astro';
import { cases } from '../data/cases';

const work = cases.filter((c) => c.ready);
const path = [
  { when: '01', title: 'Studied', line: 'Computer science (AI & Data Science) at SASTRA University.' },
  { when: '02', title: 'Payments data', line: 'Built the payments database an AI assistant answered from.' },
  { when: '03', title: 'Testing AI', line: 'Caught its wrong answers before launch. That’s how I found AI engineering.' },
  { when: '04', title: 'Shipping agents', line: 'Building and securing AI agents in production: platform, tools, guardrails.' },
];
const blurbs: Record<string, { tag: string; line: string }> = {
  'agent-platform': { tag: 'Platform · Go · TypeScript', line: 'The engine, studio and gateways behind company-wide AI agents, and how I kept them running.' },
  'mcp-connections': { tag: 'MCP · OAuth · Gateway', line: 'Connectors that let agents use real apps, with each person’s own access and no shared keys.' },
  security: { tag: 'Security · Defence in depth', line: 'Six layers, each closed by default, and every fix proven by replaying the attack.' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nityashree S · AI Engineer</title>
    <meta name="description" content="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
    <Meta title="Nityashree S · AI Engineer" description="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
  </head>
  <body class="studio home" id="top">
    <Nav />
    <main>
      <section class="h-open light" data-light>
        <div class="h-open-text">
          <h1>Hi, I’m Nitya.</h1>
          <p class="h-lead">I’m an AI engineer. I build AI agents people can trust, and prove it before they ship.</p>
          <div class="h-cta"><a class="btn-solid" href="#work">See the work</a><a class="btn-line" href="/Nityashree_S_Resume.pdf" target="_blank" rel="noopener">Resume</a></div>
        </div>
        <figure class="photo">
          <picture>
            <source srcset="/portrait.webp" type="image/webp" />
            <img src="/portrait.jpg" alt="Nityashree S, smiling" width="980" height="1220" fetchpriority="high" />
          </picture>
        </figure>
      </section>

      <section class="h-path light" id="about" data-light>
        <p class="kicker">My path</p>
        <h2>From payments data to production AI.</h2>
        <ol class="path-steps">
          {path.map((p) => <li><span>{p.when}</span><h3>{p.title}</h3><p>{p.line}</p></li>)}
        </ol>
      </section>

      <section class="h-how" id="how">
        <div class="how-text">
          <p class="kicker">How I work</p>
          <h2>One laptop, a team of agents,<br /> and me in the loop.</h2>
          <p>Subagents research, challenge and review in parallel. I set the bar, read every line, and own what ships.</p>
          <ol class="how-steps"><li>Plan</li><li>Delegate</li><li>Prove</li><li>Own</li></ol>
        </div>
        <div class="how-phone"><Phone /></div>
      </section>

      <section class="h-work" id="work">
        <div class="story-head"><p class="kicker">Selected work</p><h2>Three things I built.</h2></div>
        <div class="w-grid">
          {work.map((c) => (
            <a class="w-card" href={`/work/${c.slug}/`}>
              <div class:list={['w-art', `art-${c.slug}`]}>
                {c.slug === 'agent-platform' && (
                  <div class="mini-win"><i /><i /><i /><p class="r">turn failed · bad skill header</p><p class="r">turn failed · bad skill header</p><p class="g">fixed · agent answers again</p></div>
                )}
                {c.slug === 'mcp-connections' && (
                  <div class="mini-flow"><span>agent</span><b /><span>gateway</span><b /><span>connector</span><b /><span>app</span></div>
                )}
                {c.slug === 'security' && (
                  <div class="mini-stack">{['edge', 'identity', 'tenant', 'model', 'sandbox'].map((l, i) => <span class:list={{ hit: i === 2 }}>{l}{i === 2 && <em>blocked</em>}</span>)}</div>
                )}
              </div>
              <div class="w-meta">
                <span class="w-no">Case {c.no} · {blurbs[c.slug].tag}</span>
                <h3>{c.title}</h3>
                <p>{blurbs[c.slug].line}</p>
                <span class="w-go">Read the case study →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="h-contact light" id="contact" data-light>
        <div class="ct-text">
          <p class="kicker">Contact</p>
          <h2>Let’s build something<br />people can rely on.</h2>
        </div>
        <ul class="ct-cards">
          <li class="ct-card ct-mail">
            <a href="mailto:nitya08shree@gmail.com"><span class="ct-k">Email</span><b>nitya08shree@gmail.com</b><span class="ct-d">The fastest way to reach me</span></a>
            <button type="button" class="ct-copy" data-copy="nitya08shree@gmail.com" aria-label="Copy email address">Copy</button>
          </li>
          <li class="ct-card"><a href="https://www.linkedin.com/in/nityashree-s-b34b1b291" target="_blank" rel="noopener"><span class="ct-k">LinkedIn</span><b>Nityashree S</b><span class="ct-d">My experience</span></a></li>
          <li class="ct-card"><a href="https://github.com/Nityaa08" target="_blank" rel="noopener"><span class="ct-k">GitHub</span><b>@Nityaa08</b><span class="ct-d">My side projects and code</span></a></li>
          <li class="ct-card"><a href="/Nityashree_S_Resume.pdf" target="_blank" rel="noopener"><span class="ct-k">Resume</span><b>One page, PDF</b><span class="ct-d">Everything here, condensed</span></a></li>
        </ul>
      </section>
    </main>
    <footer class="foot light" data-light>
      <span>© Nityashree S</span>
      <span class="foot-sig">All rights reserved. No prompts injected.</span>
      <a href="#top">Back to top ↑</a>
    </footer>
    <StagePlayer />
    <script>
      // Nav switches to its light style while it sits over a light section.
      const navEl = document.getElementById('nav')!;
      const lights = [...document.querySelectorAll<HTMLElement>('[data-light]')];
      const paint = () => { const y = 34; navEl.classList.toggle('on-light', lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= y && r.bottom > y; })); };
      paint(); addEventListener('scroll', paint, { passive: true }); addEventListener('resize', paint);
            document.querySelectorAll<HTMLButtonElement>('.ct-copy').forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1600); } catch { location.href = 'mailto:' + b.dataset.copy; }
      }));
    </script>
  </body>
</html>
