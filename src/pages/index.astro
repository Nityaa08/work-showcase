---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import StagePlayer from '../components/StagePlayer.astro';
import Meta from '../components/Meta.astro';
import { cases, stackOf as stackOfCase } from '../data/cases';
import { hero, how, contact, path, blurbs, outside } from '../data/home';

const work = cases.filter((c) => c.ready);
// The stack of each project, from the case study's "at a glance" strip.
const stackOf = (slug: string) => stackOfCase(cases.find((c) => c.slug === slug));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nityashree S · AI Engineer</title>
    <meta name="description" content="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
    <Meta title="Nityashree S · AI Engineer" description="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
  </head>
  <body class="studio home" id="top">
    <Nav />
    <main>
      <section class="h-open light" data-light>
        <div class="h-open-text">
          <p class="h-hi">{hero.hi}</p>
          <h1>{hero.headline}</h1>
          <p class="h-sub">{hero.sub}</p>
          <div class="h-actions">
            <a class="h-resume" href={contact.resume} target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a>
            <a class="h-more" href="#work">See my work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="photo">
          <picture>
            <source srcset="/portrait-muted.webp" type="image/webp" />
            <img src="/portrait-muted.jpg" alt="Nityashree S, smiling" width="980" height="1220" fetchpriority="high" />
          </picture>
        </figure>
      </section>

      <section class="h-work" id="work">
        <div class="story-head"><h2>Selected work</h2></div>
        <div class="w-grid">
          {work.map((c) => (
            <a class="w-card" href={`/work/${c.slug}/`}>
              <div class:list={['w-art', `art-${c.slug}`]}>
                {c.slug === 'agent-platform' && (
                  <div class="mini-win"><i /><i /><i /><p class="r">turn failed · bad skill header</p><p class="r">turn failed · bad skill header</p><p class="g">fixed · agent answers again</p></div>
                )}
                {c.slug === 'mcp-connections' && (
                  <div class="mini-flow"><span>agent</span><b /><span>gateway</span><b /><span>connector</span><b /><span>app</span></div>
                )}
                {c.slug === 'security' && (
                  <div class="mini-stack">{['edge', 'identity', 'tenant', 'model', 'sandbox'].map((l, i) => <span class:list={{ hit: i === 2 }}>{l}{i === 2 && <em>blocked</em>}</span>)}</div>
                )}
              </div>
              <div class="w-meta">
                <span class="w-no">Case {c.no}</span>
                <h3>{c.title}</h3>
                <p>{blurbs[c.slug]}</p>
                <ul class="w-stack" aria-label="Stack">{stackOf(c.slug).map((t) => <li>{t}</li>)}</ul>
                <span class="w-go">Read the case study →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="h-how" id="how">
        <div class="how-text">
          <p class="kicker">How I work</p>
          <h2>One laptop, a team of agents,<br /> and me in the loop.</h2>
          <p>{how.text}</p>
          <ol class="how-steps">{how.steps.map((x) => <li>{x}</li>)}</ol>
          <p class="how-tools">{how.tools}</p>
        </div>
        <div class="how-phone"><Phone /></div>
      </section>

      <section class="h-path light" id="about" data-light>
        <p class="kicker">My path</p>
        <h2>From payments data to production AI.</h2>
        <ol class="path-steps">
          {path.map((p) => <li><span>{p.when}</span><h3>{p.title}</h3><p>{p.line}</p></li>)}
        </ol>
      </section>

      <section class="h-outside light" id="outside" data-light>
        <p class="kicker">Outside work</p>
        <h2>A few things about me.</h2>
        <ul class="ow-list">
          {outside.map((o) => (
            <li>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.icon} /></svg>
              <div><h3>{o.t}</h3><p>{o.d}</p></div>
            </li>
          ))}
        </ul>
      </section>

      <section class="h-contact light" id="contact" data-light>
        <div class="ct-text">
          <p class="kicker">Contact</p>
          <h2>Let’s talk.</h2>
        </div>
        <ul class="ct-cards">
          <li class="ct-card ct-mail">
            <a href="mailto:nitya08shree@gmail.com"><svg class="ct-ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg><span class="ct-k">Email</span><b>nitya08shree@gmail.com</b></a>
            <button type="button" class="ct-copy" data-copy="nitya08shree@gmail.com" aria-label="Copy email address">Copy</button>
          </li>
          <li class="ct-card"><a href="https://www.linkedin.com/in/nityashree-s-b34b1b291" target="_blank" rel="noopener"><svg class="ct-ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg><span class="ct-k">LinkedIn</span><b>Nityashree S</b></a></li>
          <li class="ct-card"><a href="https://github.com/Nityaa08" target="_blank" rel="noopener"><svg class="ct-ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z" /></svg><span class="ct-k">GitHub</span><b>@Nityaa08</b></a></li>
          <li class="ct-card"><a href="/Nityashree_S_Resume.pdf" target="_blank" rel="noopener"><svg class="ct-ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg><span class="ct-k">Resume</span><b>Download PDF</b></a></li>
        </ul>
      </section>
    </main>
    <footer class="foot light" data-light>
      <span>© Nityashree S</span>
      <span class="foot-sig">All rights reserved. No prompts injected.</span>
      <a href="#top">Back to top ↑</a>
    </footer>
    <StagePlayer />
    <script>
      // Nav switches to its light style while it sits over a light section.
      const navEl = document.getElementById('nav')!;
      const lights = [...document.querySelectorAll<HTMLElement>('[data-light]')];
      const paint = () => { const y = 34; navEl.classList.toggle('on-light', lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= y && r.bottom > y; })); };
      paint(); addEventListener('scroll', paint, { passive: true }); addEventListener('resize', paint);
            document.querySelectorAll<HTMLButtonElement>('.ct-copy').forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1600); } catch { location.href = 'mailto:' + b.dataset.copy; }
      }));
    </script>
  </body>
</html>
