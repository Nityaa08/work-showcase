---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import StagePlayer from '../components/StagePlayer.astro';
import Meta from '../components/Meta.astro';
import { cases } from '../data/cases';
import { hero, how, contact, offClock, cards, desk, outsideIntro, contactLine, letter, mailto } from '../data/home';
import Desk from '../components/Desk.astro';
import Trail from '../components/Trail.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { corner, cornerCopy, books, looks, spineName } from '../data/corner';
import { getNotes } from '../lib/notes';
// The envelope's stamp: a rectangle with a perforated (scalloped) edge, traced clockwise.
const stampEdge = (() => {
  const w = 60, h = 72, r = 2.4, n = [8, 10];
  let d = 'M0 0';
  const side = (len: number, cnt: number, dx: number, dy: number) => {
    const step = len / cnt, gap = (step - 2 * r) / 2;
    for (let i = 0; i < cnt; i++) d += ` l${dx * gap} ${dy * gap} a${r} ${r} 0 0 0 ${dx * 2 * r} ${dy * 2 * r} l${dx * gap} ${dy * gap}`;
  };
  side(w, n[0], 1, 0); side(h, n[1], 0, 1); side(w, n[0], -1, 0); side(h, n[1], 0, -1);
  return d + ' Z';
})();
const write = mailto(letter.subject, letter.body);

const work = cases.filter((c) => c.ready);
// My corner's words depend on whether a note is published yet; the desk's laptop note follows them.
const cc = cornerCopy((await getNotes()).length > 0);
const deskNotes = desk.map((d) => (d.id === 'laptop' ? { ...d, note: cc.laptop } : d));
// The book spines in the My corner card: the shelf's own books, fills and proportions at a small scale, each with the
// author's surname in small caps at the foot (as on the shelf).
const miniBooks = (() => {
  const BASE = 90, GAP = 1.5;
  let x = 6;
  const out = books.map((b, i) => {
    const l = looks[b.id] ?? { w: 34, h: 210, fill: i % 2 ? 'tint' : 'paper' };
    const name = spineName(b.author);
    const w = +(l.w * 0.46).toFixed(1), h = Math.round(Math.max(l.h * 0.34, 20 + name.length * 0.8 * 6.4));
    const o = { x, w, h, y: BASE - h, fill: l.fill, name };
    x += w + GAP;
    return o;
  });
  return { list: out, end: x - GAP, base: BASE };
})();
---
<!doctype html>
<html lang="en">
  <head>
