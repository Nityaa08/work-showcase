---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Phone from '../components/Phone.astro';
import StagePlayer from '../components/StagePlayer.astro';
import Meta from '../components/Meta.astro';
import { cases } from '../data/cases';
import { hero, how, contact, path, cards, desk, outsideIntro, contactLine, letter, mailto } from '../data/home';
import Desk from '../components/Desk.astro';
// The envelope's stamp: a rectangle with a perforated (scalloped) edge, traced clockwise.
const stampEdge = (() => {
  const w = 60, h = 72, r = 2.4, n = [8, 10];
  let d = 'M0 0';
  const side = (len: number, cnt: number, dx: number, dy: number) => {
    const step = len / cnt, gap = (step - 2 * r) / 2;
    for (let i = 0; i < cnt; i++) d += ` l${dx * gap} ${dy * gap} a${r} ${r} 0 0 0 ${dx * 2 * r} ${dy * 2 * r} l${dx * gap} ${dy * gap}`;
  };
  side(w, n[0], 1, 0); side(h, n[1], 0, 1); side(w, n[0], -1, 0); side(h, n[1], 0, -1);
  return d + ' Z';
})();
const write = mailto(letter.subject, letter.body);

const work = cases.filter((c) => c.ready);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nityashree S · AI engineer</title>
    <meta name="description" content="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
    <Meta title="Nityashree S · AI engineer" description="Nityashree S builds production AI agents end to end: the platform, the MCP connectors, the guardrails and the evals." />
  </head>
  <body class="studio home" id="top">
    <Nav />
    <main>
      <section class="h-open light" data-light>
        <div class="h-open-text">
          <p class="h-hi">{hero.hi}</p>
          <h1>{hero.headline}</h1>
          <p class="h-sub">{hero.sub}</p>
          <div class="h-actions">
            <a class="h-resume" href={contact.resume} target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a>
            <a class="h-more" href="#work">See my work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="photo">
          <picture>
            <source srcset="/portrait-muted.webp" type="image/webp" />
            <img src="/portrait-muted.jpg" alt="Nityashree S, smiling" width="980" height="1220" fetchpriority="high" />
          </picture>
        </figure>
      </section>

      <section class="h-work" id="work">
        <div class="story-head"><h2>Selected work</h2></div>
        <div class="w-grid">
          {work.map((c) => (
            <a class="w-card" href={`/work/${c.slug}/`}>
              <div class:list={['w-art', `art-${c.slug}`]}>
                {c.slug === 'agent-platform' && (
                  <div class="mini-win"><i /><i /><i /><span class="mw-t">support-agent · logs</span><p class="r">✕ turn failed · bad skill header</p><p class="r">✕ turn failed · bad skill header</p><p class="y">✓ test · bad header refused on save</p><p class="g">✓ fixed · agent answers again</p></div>
                )}
                {c.slug === 'mcp-connections' && (
                  <div class="mini-flow"><span>agent</span><b /><span class="mf-gw">gateway</span><b /><span>connector</span><b /><span>app</span><i class="mf-drop" /><span class="mf-vault">vault · your own token</span></div>
                )}
                {c.slug === 'security' && (
                  <div class="mini-stack"><i class="ms-trail" aria-hidden="true" />{['edge', 'identity', 'tenant', 'model', 'sandbox', 'dependencies'].map((l, i) => <span class:list={{ pass: i < 2, hit: i === 2 }}>{l}{i === 2 && <em>blocked</em>}</span>)}</div>
                )}
              </div>
              <div class="w-meta">
                <span class="w-no">Case {c.no}</span>
                <h3>{cards[c.slug].headline}</h3>
                <p><span class="w-topic">{c.title}.</span> {cards[c.slug].text}</p>
                <span class="w-go">Read the case study →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="h-how" id="how">
        <div class="how-text">
          <p class="kicker">How I work</p>
          <h2>One laptop, a team of agents,<br /> and me in the loop.</h2>
          <p>{how.text}</p>
          <ol class="how-steps">{how.steps.map((x) => <li>{x}</li>)}</ol>
          <p class="how-tools">{how.tools}</p>
        </div>
        <div class="how-phone"><Phone /></div>
      </section>

      <section class="h-path light" id="about" data-light>
        <p class="kicker">My path</p>
        <h2>From payments data to production AI.</h2>
        <ol class="path-steps">
          {path.map((p) => <li><span>{p.when}</span><h3>{p.title}</h3><p>{p.line}</p></li>)}
        </ol>
      </section>

      <section class="h-outside light" id="outside" data-light>
        <div class="ow-text">
          <p class="kicker">Outside work</p>
          <h2>{outsideIntro.title}</h2>
          <p class="ow-intro">{outsideIntro.text}</p>
        </div>
        <div class="ow-desk"><Desk /></div>
        <div class="ow-note">
          <p class="dk-hint" id="dk-hint"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v4.5A6.5 6.5 0 0 1 11.5 21h-.6a6 6 0 0 1-4.6-2.2L3.6 15.4a1.6 1.6 0 0 1 2.4-2.1L9 16" /></svg><span><b>{outsideIntro.hint}</b> {outsideIntro.hintSub}</span></p>
          <article class="dk-card" id="dk-card" tabindex="-1" hidden aria-labelledby="dk-name">
            <div class="dk-card-top">
              <h3 class="dk-name" id="dk-name"></h3>
              <button type="button" class="dk-close" aria-label="Close note"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
            </div>
            <p class="dk-text" id="dk-text"></p>
          </article>
          <p class="sr-only" id="dk-live" aria-live="polite"></p>
          <template id="dk-notes">{desk.map((d) => <div data-k={d.id} data-name={d.name} data-note={d.note} />)}</template>
          <noscript>
            <style is:inline>.dk-hint { display: none !important; }</style>
            <ul class="dk-plain">{desk.map((d) => <li><b>{d.name}.</b> {d.note}</li>)}</ul>
          </noscript>
        </div>
      </section>

      <section class="h-contact light" id="contact" data-light>
        <div class="ct-text">
          <p class="kicker">Contact</p>
          <h2>Let’s talk.</h2>
          <p class="ct-line">{contactLine}</p>
        </div>
        <div class="ct-side">
          <div class="mail" data-mail>
            <div class="ml-tilt">
              <div class="ml-back" aria-hidden="true"></div>
              <div class="ml-letter" aria-hidden="true"><p class="ml-hi">Hi Nitya,</p><i></i><i></i><i></i></div>
              <div class="ml-front">
                <div class="ml-to">
                  <span class="ml-k" aria-hidden="true">To</span>
                  <span class="ml-name" aria-hidden="true">Nitya</span>
                  <span class="ml-addr-row">
                    <a class="ml-addr" href={write} data-write aria-label={`Write to me at ${contact.email}. Opens your email app.`}>{contact.email}</a>
                    <button type="button" class="ml-copy" data-copy={contact.email} aria-label="Copy my email address" hidden>
                      <svg class="ic-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2.5" /><path d="M16 8V5.5A2.5 2.5 0 0 0 13.5 3h-8A2.5 2.5 0 0 0 3 5.5v8A2.5 2.5 0 0 0 5.5 16H8" /></svg>
                      <svg class="ic-done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    </button>
                  </span>
                </div>
                <span class="ml-air" aria-hidden="true"></span>
              </div>
              <div class="ml-flap" aria-hidden="true"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M0.8 40 L50 1 L99.2 40" /></svg></div>
              <svg class="ml-stamp" aria-hidden="true" viewBox="-3 -3 66 78">
                <path class="ml-stamp-edge" d={stampEdge} />
                <rect class="ml-stamp-in" x="7" y="7" width="46" height="58" rx="2" />
                <text class="ml-ns" x="30" y="43" text-anchor="middle">NS</text>
                <path class="ml-stamp-mic" d="M24 54 h12" />
              </svg>
              <svg class="ml-mark" aria-hidden="true" viewBox="0 0 110 60">
                <defs><path id="ml-arc" d="M11.8 40.5 A21 21 0 1 1 48.2 40.5" /></defs>
                <circle cx="30" cy="30" r="27" /><circle cx="30" cy="30" r="15" />
                <text><textPath href="#ml-arc" startOffset="50%" text-anchor="middle">SENT WITH CARE</textPath></text>
                <path class="ml-heart" d="M30 38 C24 34 23.5 29.5 26.5 28.6 C28 28.2 29.4 29.2 30 30.4 C30.6 29.2 32 28.2 33.5 28.6 C36.5 29.5 36 34 30 38 Z" />
                <path class="ml-wave" d="M60 20 q6 -5 12 0 t12 0 t12 0 t12 0 M60 30 q6 -5 12 0 t12 0 t12 0 t12 0 M60 40 q6 -5 12 0 t12 0 t12 0 t12 0" />
              </svg>
              <span class="ml-copied" aria-hidden="true">Copied</span>
            </div>
          </div>
          <p class="ct-hint" id="ct-hint" data-fallback={letter.fallback} hidden><span class="ct-hint-p">{letter.hint}</span><span class="ct-hint-t">{letter.hintTouch}</span></p>
          <p class="sr-only" id="ct-status" role="status" aria-live="polite"></p>
          <ul class="ct-links" aria-label="Elsewhere">
            <li><a href={contact.linkedin} target="_blank" rel="noopener"><svg class="ct-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg><span>LinkedIn</span><i class="ct-arr" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg></i></a></li>
            <li><a href={contact.github} target="_blank" rel="noopener"><svg class="ct-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg><span>GitHub</span><i class="ct-arr" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg></i></a></li>
            <li><a href={contact.resume} target="_blank" rel="noopener" aria-label="Resume (PDF)"><svg class="ct-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-12z" /><path d="M14 2.5v4a1.5 1.5 0 0 0 1.5 1.5h4M9 13h6M9 17h6" /></svg><span>Resume</span><i class="ct-arr" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5v7M3 6.5l3 3 3-3" /></svg></i></a></li>
          </ul>
        </div>
      </section>
    </main>
    <footer class="foot light" data-light>
      <span>© Nityashree S</span>
      <span class="foot-sig">Made with care. No prompts injected.</span>
      <a href="#top">Back to top ↑</a>
    </footer>
    <StagePlayer />
    <script>
      // Nav switches to its light style while it sits over a light section.
      const navEl = document.getElementById('nav')!;
      const lights = [...document.querySelectorAll<HTMLElement>('[data-light]')];
      const paint = () => { const y = 34; navEl.classList.toggle('on-light', lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= y && r.bottom > y; })); };
      paint(); addEventListener('scroll', paint, { passive: true }); addEventListener('resize', paint);
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      const wait = (ms: number) => new Promise((r) => setTimeout(r, still.matches ? 0 : ms));

      // --- The desk: every object is a button that opens one note at a time. ---
      const deskEl = document.querySelector<HTMLElement>('[data-desk]');
      if (deskEl) {
        // Idle motion only runs while the desk is on screen.
        new IntersectionObserver(([e]) => deskEl.classList.toggle('in', e.isIntersecting), { rootMargin: '60px 0px' }).observe(deskEl);
        const notes = new Map([...(document.getElementById('dk-notes') as HTMLTemplateElement).content.querySelectorAll<HTMLElement>('[data-k]')].map((n) => [n.dataset.k!, n.dataset]));
        const card = document.getElementById('dk-card')!, hint = document.getElementById('dk-hint')!, live = document.getElementById('dk-live')!;
        const nameEl = card.querySelector('.dk-name')!, textEl = card.querySelector('.dk-text')!;
        const btns = [...deskEl.querySelectorAll<HTMLButtonElement>('.dk-hit')];
        const btn = (k: string) => btns.find((x) => x.dataset.k === k)!;
        const objs = (k: string) => deskEl.querySelectorAll(`[data-obj="${k}"], [data-for="${k}"]`);
        const mark = (k: string, cls: string, on: boolean) => objs(k).forEach((o) => o.classList.toggle(cls, on));
        let open = '', seq = 0;
        const setText = (k: string) => { const n = notes.get(k)!; nameEl.textContent = n.name!; textEl.textContent = n.note!; };
        const close = (focusBack = false) => {
          if (!open) return;
          const b = btn(open);
          mark(open, 'open', false); b.setAttribute('aria-expanded', 'false');
          seq++; card.classList.remove('show', 'swap'); card.hidden = true; hint.hidden = false; live.textContent = '';
          open = '';
          if (focusBack) b.focus();
        };
        const show = (k: string) => {
          const n = notes.get(k)!, was = open, my = ++seq;
          if (was) { mark(was, 'open', false); btn(was).setAttribute('aria-expanded', 'false'); }
          open = k; mark(k, 'open', true); btn(k).setAttribute('aria-expanded', 'true');
          card.dataset.k = k;
          if (was && !card.hidden) {
            // Switching notes: the card stays put and only its words cross-fade.
            card.classList.add('swap');
            window.setTimeout(() => { if (my !== seq) return; setText(k); card.classList.remove('swap'); }, still.matches ? 0 : 180);
          } else {
            setText(k); card.classList.remove('show', 'swap');
            hint.hidden = true; card.hidden = false;
            requestAnimationFrame(() => requestAnimationFrame(() => { if (my === seq || open === k) card.classList.add('show'); }));
          }
          // The globe's plane flies its route (SMIL); with motion off it simply lands.
          if (k === 'globe') { const fly = deskEl.querySelector<SVGAnimationElement>('.dk-plane animateMotion'); if (fly) { fly.setAttribute('dur', still.matches ? '0.01s' : '2s'); try { fly.beginElement(); } catch {} } }
          live.textContent = `${n.name}. ${n.note}`;
          // On a phone the note sits under the drawing: bring it into view if it is below the fold.
          const r = card.getBoundingClientRect();
          if (r.bottom > innerHeight) card.scrollIntoView({ block: 'nearest', behavior: still.matches ? 'auto' : 'smooth' });
        };
        btns.forEach((b) => {
          const k = b.dataset.k!;
          b.addEventListener('pointerenter', () => mark(k, 'hot', true));
          b.addEventListener('pointerleave', () => mark(k, 'hot', false));
          b.addEventListener('focus', () => b.matches(':focus-visible') && mark(k, 'hot', true));
          b.addEventListener('blur', () => mark(k, 'hot', false));
          b.addEventListener('click', () => (open === k ? close() : show(k)));
        });
        card.querySelector('.dk-close')!.addEventListener('click', () => close(true));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) close(true); });
      }

      // --- Contact: an envelope addressed to me. Clicking it (or the address) tucks the letter in, closes the flap,
      // postmarks the stamp, then opens the visitor's own email app. The icon beside the address copies it.
      // Nothing is sent anywhere. Without JavaScript the address is a plain email link.
      const mail = document.querySelector<HTMLElement>('[data-mail]');
      const addr = document.querySelector<HTMLAnchorElement>('[data-write]');
      const status = document.getElementById('ct-status');
      const ctHint = document.getElementById('ct-hint');
      const copyBtn = document.querySelector<HTMLButtonElement>('.ml-copy');
      if (mail && addr) {
        mail.classList.add('js');
        if (ctHint) ctHint.hidden = false;
        if (copyBtn) copyBtn.hidden = false;
        // The letter peeks out of the envelope the first time it scrolls into view.
        new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); mail.classList.add('in'); } }, { threshold: 0.3 }).observe(mail);
        addr.addEventListener('focus', () => addr.matches(':focus-visible') && mail.classList.add('hot'));
        addr.addEventListener('blur', () => mail.classList.remove('hot'));
        // The whole envelope is the button; the address link and the copy icon handle their own clicks.
        mail.addEventListener('click', (e) => { const t = e.target as Element; if (t.closest('.ml-copy, [data-write]')) return; addr.click(); });
        let busy = false;
        const go = () => {
          addr.dataset.go = '1'; addr.click();
          if (status) status.textContent = 'Opening your email app.';
          if (ctHint && ctHint.dataset.fallback) { ctHint.textContent = ctHint.dataset.fallback; ctHint.classList.add('after'); }
        };
        addr.addEventListener('click', async (e) => {
          if (addr.dataset.go) { delete addr.dataset.go; return; } // second pass: let the mailto link open
          e.preventDefault();
          if (busy) return; busy = true;
          mail.classList.add('in'); mail.classList.remove('stamped', 'copied'); void mail.offsetWidth;
          // go() runs on the next tick: a nested click on the same link would be ignored while this one is in progress.
          if (still.matches) { mail.classList.add('stamped'); window.setTimeout(() => { go(); busy = false; }, 0); return; }
          mail.classList.add('send');
          await wait(950); mail.classList.add('stamped');
          await wait(650); go();
          await wait(1500); mail.classList.remove('send');
          await wait(900); busy = false;
        });
        // Copy: the icon turns into a tick and a "Copied" stamp lands on the envelope.
        if (copyBtn) {
          let t = 0;
          copyBtn.addEventListener('click', async () => {
            const v = copyBtn.dataset.copy!;
            let ok = false;
            try { await navigator.clipboard.writeText(v); ok = true; } catch {
              const ta = document.createElement('textarea'); ta.value = v; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.append(ta); ta.select(); try { ok = document.execCommand('copy'); } catch {} ta.remove();
            }
            copyBtn.classList.toggle('done', ok);
            copyBtn.setAttribute('aria-label', ok ? 'Copied' : 'Copy my email address');
            if (status) status.textContent = ok ? 'Email address copied.' : `Copy didn’t work. The address is selected: ${v}.`;
            mail.classList.remove('copied'); void mail.offsetWidth; if (ok) mail.classList.add('copied');
            if (!ok) { const r = document.createRange(); r.selectNodeContents(addr); getSelection()!.removeAllRanges(); getSelection()!.addRange(r); }
            clearTimeout(t);
            t = window.setTimeout(() => { copyBtn.classList.remove('done'); copyBtn.setAttribute('aria-label', 'Copy my email address'); mail.classList.remove('copied'); }, 2000);
          });
        }
      }
    </script>
  </body>
</html>
