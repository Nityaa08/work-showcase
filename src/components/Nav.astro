---
interface Props { crumb?: string; active?: 'work' | 'about' }
const { crumb, active } = Astro.props;
---
<header class="nav" id="nav">
  <a class="brand" href="/" aria-label="Nityashree S, home">
    <span class="brand-who"><b>Nityashree S</b></span>
  </a>
  {crumb && <span class="crumb"><a href="/#work">Work</a><span>/</span>{crumb}</span>}
  <nav class="links" aria-label="Main">
    <a href="/#about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
    <a href="/#work" aria-current={active === 'work' ? 'page' : undefined}>Work</a>
    <a href="/Nityashree_S_Resume.pdf" target="_blank" rel="noopener">Resume</a>
    <a class="cta" href="/#contact">Contact</a>
  </nav>
</header>
<script>
  // Show the bar at the top, when scrolling up on purpose, when the pointer reaches the top edge,
  // or when it has keyboard focus. Hide it only after a deliberate scroll down.
  const nav = document.getElementById('nav')!;
  let last = scrollY, travel = 0, hovering = false;
  const set = (hide: boolean) => nav.classList.toggle('hide', hide && !hovering && !nav.matches(':focus-within'));
  // One update per frame at most (rAF), whatever the scroll event rate.
  let queued = false;
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  function update() {
    queued = false;
    const y = scrollY, d = y - last; last = y;
    nav.classList.toggle('solid', y > 24);
    if (y < 120) { travel = 0; set(false); return; }
    travel = Math.sign(d) === Math.sign(travel) ? travel + d : d;
    if (travel > 48) set(true);
    else if (travel < -64) set(false);
  }
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    addEventListener('pointermove', (e) => {
      const near = e.clientY < 72;
      if (near !== hovering) { hovering = near; if (near) set(false); }
    }, { passive: true });
  }
  nav.addEventListener('focusin', () => set(false));
</script>
