---
// A laptop drawn entirely in HTML/CSS: no model file, nothing to download, works on every device.
// The screen replays one calm product moment: a question, the agent's steps, an answer.
// Everything on the screen is sized in "u" units (1u = 1/1024 of the screen width), so it scales with the laptop.
// Round 20: the screen holds only the key text, set large enough to read: the smallest text is 25u, which is at least
// 11px wherever the screen shows text (it is never narrower than about 457px from 601px wide up). On phones the screen
// is too small for any text to be read, so it shows the same moment as a wordless sketch and a short caption under it.
const steps = [
  { label: 'Remembered how Nitya likes answers', at: 0.6 },
  { label: 'Loaded the “summarise failures” skill', at: 1.4 },
  { label: 'Searched logs, payments and docs', at: 2.6 },
  { label: 'Wrote the answer', at: 4.0 },
  { label: 'Checked it’s in Nitya’s language', at: 4.7 },
];
const question = 'Summarise yesterday’s failed checkouts.';
---
<figure class="lap" data-laptop>
  <div class="lp-lid" aria-hidden="true">
    <div class="lp-screen">
      <div class="lp-desk">
        <div class="lp-menubar"><span class="lp-mb-apple"></span><i></i><i></i><i></i><span class="lp-mb-r"><i></i><i></i></span></div>
        <div class="lp-win">
          <div class="lp-win-top">
            <i class="lp-tl lp-r"></i><i class="lp-tl lp-y"></i><i class="lp-tl lp-g"></i>
            <span class="lp-win-name"><span>support-agent</span></span>
          </div>
          <div class="lp-chat">
            <div class="lp-msg">
              <span class="lp-av">N</span>
              <p class="lp-q"><span>{question}</span></p>
            </div>
            <div class="lp-run">
              <p class="lp-run-head" data-head><span>Working on it…</span></p>
              {steps.map((s) => (
                <p class="lp-step" data-at={s.at}><i class="lp-dot"></i><span class="lp-lbl"><span>{s.label}</span></span></p>
              ))}
            </div>
            <div class="lp-msg lp-ans" data-answer>
              <span class="lp-av lp-ok">✦</span>
              <p class="lp-a"><span>Mostly card declines; the rest were timeouts.</span></p>
            </div>
          </div>
        </div>
      </div>
      <span class="lp-notch"></span>
    </div>
  </div>
  <div class="lp-base" aria-hidden="true"><span class="lp-groove"></span></div>
  <figcaption class="lp-cap">An agent answers “{question.replace(/\.$/, '')}”, step by step: memory, a skill, tools, the model, then a language check.</figcaption>
</figure>

<style>
  /* The shadow is a box-shadow, not a drop-shadow filter: a filter is re-drawn every time the screen ticks, which dropped frames. */
  .lap { --alu: #c9cbcf; margin: 0 0 0 auto; width: 100%; max-width: 820px; }
  .lp-lid { position: relative; padding: 1.6%; border-radius: 3.2% / 4.8%; background: #0a0a0b; box-shadow: 0 0 0 1.5px #3a3b3e, inset 0 0 0 1px #1b1b1d, 0 40px 60px rgba(0, 0, 0, 0.55); }
  .lp-screen { position: relative; aspect-ratio: 1.547; border-radius: 1.2% / 1.8%; overflow: hidden; container-type: inline-size; background: #000; }
  @supports not (aspect-ratio: 1 / 1) { .lp-screen::before { content: ''; display: block; padding-top: 64.64%; } }
  .lp-notch { position: absolute; top: 0; left: 50%; translate: -50% 0; width: 9%; height: 2.6%; background: #0a0a0b; border-radius: 0 0 1cqw 1cqw; }
  .lp-base { position: relative; height: clamp(10px, 2.2vw, 22px); margin: 0 -6%; border-radius: 0 0 14px 14px / 0 0 100% 100%; background: linear-gradient(180deg, #e3e4e6 0%, var(--alu) 30%, #8c8e92 100%); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 30px 40px -12px rgba(0, 0, 0, 0.55); }
  .lp-groove { position: absolute; top: 0; left: 50%; translate: -50% 0; width: 15%; height: 42%; border-radius: 0 0 10px 10px; background: linear-gradient(180deg, #9a9ca0, #b9bbbf); }
  /* the caption is read by screen readers everywhere, and shown only on phones (see below) */
  .lp-cap { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* the screen (1u = 1/1024 of the screen width; px fallbacks first for browsers without container units) */
  .lp-desk { --u: 0.6px; --u: calc(100cqw / 1024); position: absolute; top: 0; right: 0; bottom: 0; left: 0; font-family: var(--sans); color: #1c1c1e;
    background:
      radial-gradient(35% 45% at 20% 55%, rgba(60, 140, 230, 0.55), transparent 70%),
      radial-gradient(30% 40% at 95% 85%, rgba(210, 225, 255, 0.5), transparent 70%),
      linear-gradient(125deg, #9fc0e6 0%, #d9cfa6 30%, #7aa6dc 55%, #2b5fd0 78%, #0d2a8f 100%); }
  .lp-desk p { margin: 0; }
  /* the menu bar is a quiet strip: no words, just the shapes of a menu */
  .lp-menubar { display: flex; align-items: center; gap: calc(var(--u) * 22); height: calc(var(--u) * 28); padding: 0 calc(var(--u) * 18); background: rgba(255, 255, 255, 0.18); }
  .lp-menubar i { width: calc(var(--u) * 34); height: calc(var(--u) * 7); border-radius: 99px; background: rgba(255, 255, 255, 0.75); }
  .lp-mb-apple { width: calc(var(--u) * 13); height: calc(var(--u) * 14); border-radius: 50% 50% 45% 45%; background: #fff; }
  .lp-mb-r { margin-left: auto; display: flex; gap: calc(var(--u) * 14); }
  .lp-mb-r i { width: calc(var(--u) * 22); }
  .lp-win { position: absolute; left: calc(var(--u) * 92); right: calc(var(--u) * 92); top: calc(var(--u) * 52); bottom: calc(var(--u) * 40); border-radius: calc(var(--u) * 14); background: #fbfbfa; overflow: hidden; box-shadow: 0 calc(var(--u) * 14) calc(var(--u) * 40) rgba(0, 10, 40, 0.45); display: flex; flex-direction: column; }
  .lp-win-top { position: relative; flex: none; display: flex; align-items: center; gap: calc(var(--u) * 9); height: calc(var(--u) * 54); padding: 0 calc(var(--u) * 18); background: #f2f2f0; border-bottom: 1px solid #e6e6e3; }
  .lp-tl { width: calc(var(--u) * 14); height: calc(var(--u) * 14); border-radius: 50%; } .lp-tl.lp-r { background: #ff5f57; } .lp-tl.lp-y { background: #febc2e; } .lp-tl.lp-g { background: #28c840; }
  .lp-win-name { position: absolute; left: 50%; translate: -50% 0; font-size: calc(var(--u) * 25); font-weight: 600; color: #3a3a3c; white-space: nowrap; }
  .lp-chat { flex: 1; min-height: 0; padding: calc(var(--u) * 28) calc(var(--u) * 34); display: flex; flex-direction: column; gap: calc(var(--u) * 20); }
  .lp-msg { display: flex; align-items: center; gap: calc(var(--u) * 14); }
  .lp-av { flex: none; display: grid; place-items: center; width: calc(var(--u) * 42); height: calc(var(--u) * 42); border-radius: 50%; background: #5b6170; color: #fff; font-size: calc(var(--u) * 22); font-weight: 600; }
  .lp-av.lp-ok { background: #3a3b3f; }
  .lp-q { font-size: calc(var(--u) * 29); font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
  .lp-a { font-size: calc(var(--u) * 27); line-height: 1.3; }
  .lp-run { padding: calc(var(--u) * 16) calc(var(--u) * 22) calc(var(--u) * 12); border-radius: calc(var(--u) * 14); background: #f4f5f7; box-shadow: inset 0 0 0 1px #e6e6e3; }
  .lp-run-head { font-size: calc(var(--u) * 25); font-weight: 600; color: #55575c; margin-bottom: calc(var(--u) * 6) !important; }
  .lp-run-head.lp-done { color: #1f6f34; }
  .lp-step { display: flex; align-items: center; gap: calc(var(--u) * 14); height: calc(var(--u) * 42); font-size: calc(var(--u) * 25); color: #1c1c1e; opacity: 0.4; transition: opacity var(--t-base) var(--ease); }
  .lp-step .lp-lbl { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lp-dot { position: relative; flex: none; width: calc(var(--u) * 22); height: calc(var(--u) * 22); border-radius: 50%; box-shadow: inset 0 0 0 1.5px #b9b9be; }
  .lp-step.lp-run-now { opacity: 1; } .lp-step.lp-run-now .lp-dot { box-shadow: none; border: 2px solid #6e6e73; border-right-color: transparent; animation: spin 0.9s linear infinite; }
  .lp-step.lp-done { opacity: 1; } .lp-step.lp-done .lp-dot { box-shadow: none; background: #d6f2dc; }
  .lp-step.lp-done .lp-dot::after { content: '✓'; position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: grid; place-items: center; font-size: calc(var(--u) * 15); font-weight: 700; color: #1f6f34; }
  .lp-ans { opacity: 0; transform: translateY(calc(var(--u) * 6)); transition: opacity var(--t-slow) var(--ease), transform var(--t-slow) var(--ease); }
  .lp-ans.lp-show { opacity: 1; transform: none; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 960px) { .lp-lap, .lap { width: 88%; margin: 8px auto 0; } }
  /* Phones: the screen is about 300px wide, too small for any text to be read. It keeps the same moment as a sketch
     (each line of text becomes a soft grey bar, the steps still tick) and a short caption under the laptop says it. */
  @media (max-width: 600px) {
    .lp-desk .lp-win-name > span, .lp-desk .lp-q > span, .lp-desk .lp-a > span, .lp-desk .lp-run-head > span, .lp-desk .lp-lbl > span { color: transparent; border-radius: 99px; background: #dcdcd8; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
    .lp-desk .lp-q > span { background: #c9c9c4; }
    .lp-desk .lp-av { color: transparent; }
    .lp-cap { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal; display: block; margin: 22px auto 0; max-width: 34ch; font-size: 14.5px; line-height: 1.55; color: var(--ink-2); text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .lp-step, .lp-ans { transition: none; } .lp-step.lp-run-now .lp-dot { animation: none; } }
</style>

<script>
  const ANSWER_AT = 5.2, LOOP = 10.5;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-laptop]').forEach((lap) => {
    const steps = [...lap.querySelectorAll<HTMLElement>('.lp-step')];
    const head = lap.querySelector<HTMLElement>('[data-head]')!;
    const headText = head.querySelector('span')!;
    const answer = lap.querySelector<HTMLElement>('[data-answer]')!;
    const render = (t: number) => {
      steps.forEach((s, i) => {
        const at = Number(s.dataset.at), prev = i ? Number(steps[i - 1].dataset.at) : 0;
        s.classList.toggle('lp-done', t >= at);
        s.classList.toggle('lp-run-now', t < at && t >= prev);
      });
      const finished = t >= ANSWER_AT;
      const label = finished ? 'Done' : 'Working on it…';
      if (headText.textContent !== label) headText.textContent = label; // write only on change: a rewrite repaints the screen
      head.classList.toggle('lp-done', finished);
      answer.classList.toggle('lp-show', finished);
    };
    if (reduced) { render(99); return; }
    let visible = false, start = performance.now();
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(lap);
    setInterval(() => { if (visible) render(((performance.now() - start) / 1000) % LOOP); }, 120);
    render(0);
  });
</script>
