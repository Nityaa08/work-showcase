---
// "My path" as a hand-drawn trail: one dashed line that winds past four stops, each a small line-art drawing in the
// desk's style (grey ink, near-black for small emphasis, light grey tints; no other hue). Horizontal on desktop,
// vertical on phones and tablets. Styles and motion live in global.css ("My path: the trail").
//
// Geometry. The four stops sit in four equal columns (desktop) or four equal rows (phones), so their centres are at
// 12.5%, 37.5%, 62.5% and 87.5% of the list. The trail's box runs from the list's start edge to the last stop's
// centre (87.5%), so inside it the stops are at 1/7, 3/7, 5/7 and 1. The line crosses each stop on the centre line
// and swings out between them. The path, the paper plane's flight and each stop's pop-in delay are all worked out
// here from that one description, so they always agree.
//
// Motion (plays once, when the list scrolls into view): the line is revealed by a clip that slides with it (a
// translated wrapper and a counter-translated svg, both transform only); the plane rides the reveal's front edge
// (one element moves along the trail by transform, a second adds the swing, its tilt and the final hop to the
// agent hub, sampled from the same curve); each stop pops in (scale and opacity) as the line reaches it.
import { path } from '../data/home';

const STOPS = [1 / 7, 3 / 7, 5 / 7, 1];
// Each segment's swing: the lead-in from the start dot, then one gentle wave between each pair of stops.
const SEG = [[0, STOPS[0], -0.5], [STOPS[0], STOPS[1], 1], [STOPS[1], STOPS[2], -1], [STOPS[2], STOPS[3], 1]] as const;
// Two layouts. `len`: the main axis in path units (scaled to the box). `c`/`a`: the cross axis centre and swing in px
// (the box is exactly that tall or wide, so px are exact). `nom`: a typical box length in px, for the plane's tilt.
// `hand`: where the plane lands, from the last stop's centre (main, cross) in px.
const H = { len: 1000, c: 60, a: 22, nom: 1100, hand: [38, -16] };
const V = { len: 1000, c: 34, a: 19, nom: 560, hand: [-12, 27] };

// One cubic per segment, controls at 35% and 65% of its length, so its peak (75% of the control height) is `a`.
const bez = (p0: number, p1: number, p2: number, p3: number, t: number) => { const u = 1 - t; return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3; };
const curve = (L: typeof H, m: number) => {
  const s = SEG.find(([a, b]) => m <= b + 1e-9) ?? SEG[3];
  const [m0, m1, sw] = s, w = m1 - m0, h = (sw * L.a) / 0.75;
  const xs = [m0, m0 + 0.35 * w, m1 - 0.35 * w, m1], ys = [0, h, h, 0];
  let lo = 0, hi = 1;
  for (let i = 0; i < 40; i++) { const mid = (lo + hi) / 2; if (bez(xs[0], xs[1], xs[2], xs[3], mid) < m) lo = mid; else hi = mid; }
  const t = (lo + hi) / 2, e = 1e-4;
  const dx = bez(xs[0], xs[1], xs[2], xs[3], Math.min(1, t + e)) - bez(xs[0], xs[1], xs[2], xs[3], Math.max(0, t - e));
  const dy = bez(ys[0], ys[1], ys[2], ys[3], Math.min(1, t + e)) - bez(ys[0], ys[1], ys[2], ys[3], Math.max(0, t - e));
  return { off: bez(ys[0], ys[1], ys[2], ys[3], t), dm: dx * L.nom, dc: dy };
};
const f = (n: number) => +n.toFixed(2);
const d = (L: typeof H, vertical: boolean) => {
  const P = (m: number, c: number) => (vertical ? `${f(L.c + c)} ${f(m * L.len)}` : `${f(m * L.len)} ${f(L.c + c)}`);
  return `M${P(0, 0)}` + SEG.map(([m0, m1, sw]) => { const w = m1 - m0, h = (sw * L.a) / 0.75; return ` C${P(m0 + 0.35 * w, h)} ${P(m1 - 0.35 * w, h)} ${P(m1, 0)}`; }).join('');
};

// Travel timing: the site's --ease-in-out, cubic-bezier(.45, 0, .3, 1), solved exactly as the browser does.
const E = [0.45, 0, 0.3, 1];
const ease = (x: number) => {
  let lo = 0, hi = 1;
  for (let i = 0; i < 50; i++) { const mid = (lo + hi) / 2; if (bez(0, E[0], E[2], 1, mid) < x) lo = mid; else hi = mid; }
  return bez(0, E[1], E[3], 1, (lo + hi) / 2);
};
const invEase = (y: number) => { let lo = 0, hi = 1; for (let i = 0; i < 50; i++) { const mid = (lo + hi) / 2; if (ease(mid) < y) lo = mid; else hi = mid; } return (lo + hi) / 2; };
const START = 0.1, TRAVEL = 1.2; // seconds: quick enough that the last stop shows before a fast scroller moves on
const NOSE = 18.4; // the plane is drawn nose up-right, 18.4deg above its tail
const LAND = -16; // its resting tilt beside the agent hub (as the contact plane rests)
const smooth = (x: number) => { const k = Math.min(1, Math.max(0, x)); return k * k * (3 - 2 * k); };
const frames = (L: typeof H, vertical: boolean) => {
  const out: string[] = [];
  for (let k = 0; k <= 80; k++) {
    const tau = k / 80, m = ease(tau), { off, dm, dc } = curve(L, m);
    const ang = vertical ? (Math.atan2(dm, dc) * 180) / Math.PI : (Math.atan2(dc, dm) * 180) / Math.PI;
    const w = smooth((m - (STOPS[2] + 0.45 * (STOPS[3] - STOPS[2]))) / (0.55 * (STOPS[3] - STOPS[2]))); // hop to the hand over the last stretch
    const main = w * L.hand[0], cross = (1 - w) * off + w * L.hand[1];
    const rot = (1 - w) * (ang + NOSE) + w * LAND;
    const [x, y] = vertical ? [cross, main] : [main, cross];
    const op = tau < 0.04 ? f(tau / 0.04) : 1;
    out.push(`${f(tau * 100)}%{transform:translate(${f(x)}px,${f(y)}px) rotate(${f(rot)}deg);opacity:${op}}`);
  }
  return out.join('');
};
const css = `@keyframes tr-fy-h{${frames(H, false)}}@keyframes tr-fy-v{${frames(V, true)}}`;
// When the reveal reaches each stop: it pops in a little before the line arrives, so it is whole as the plane passes.
const at = STOPS.map((s) => f(START + invEase(s) * TRAVEL - 0.25));
const done = f(START + TRAVEL);
const vars = `--tr-start:${START}s;--tr-travel:${TRAVEL}s;--tr-done:${done}s;--h-land:translate(${H.hand[0]}px,${H.hand[1]}px) rotate(${LAND}deg);--v-land:translate(${V.hand[1]}px,${V.hand[0]}px) rotate(${LAND}deg)`;

// The four drawings, 100 x 100 units each, centred on the trail. A paper disc behind each hides the line under it.
// One family: flat front view, one 1.5px ink stroke throughout, corners 3 (small parts) or 10 (bubble, hub), white
// for the main surface and the light grey tint for the second one, faint lines for detail, one near-black accent per
// drawing (the tassel, one bar, the tick, the spark), and the same soft shadow underneath. On the agent stop the upper
// right is kept clear: that is where the paper plane lands.
const art = [
  // Studied: a mortarboard resting on an open book
  `<ellipse class="tr-shadow" cx="50" cy="88" rx="32" ry="3"/>
   <path class="tr-tn" d="M14 58v25.5c13-1.8 25-.9 36 3 11-3.9 23-4.8 36-3V58"/>
   <path class="tr-pp" d="M50 61c-10-5-21-6.5-33-5v25c12-1.5 23 0 33 4.5Z"/><path class="tr-pp" d="M50 61c10-5 21-6.5 33-5v25c-12-1.5-23 0-33 4.5Z"/>
   <path class="tr-fn" d="M23 64.5c6.5-.8 12.5-.2 19 2M23 70.5c6.5-.8 12.5-.2 19 2M23 76.5c6.5-.8 12.5-.2 19 2M58 66.5c6.5-2.2 12.5-2.8 19-2M58 72.5c6.5-2.2 12.5-2.8 19-2"/>
   <g transform="translate(0 3.5)"><path class="tr-tn" d="M37 41v9.5c0 5.2 26 5.2 26 0V41"/>
   <path class="tr-pp" d="M50 27.5 80 37.5 50 47.5 20 37.5Z"/>
   <path class="tr-acc-ln" d="M50 37.5 74.5 41.3V52"/><path class="tr-k" d="M72.7 51.5h3.6l1.2 8.5h-6Z"/><circle class="tr-k" cx="50" cy="37.5" r="2"/></g>`,
  // Payments data: a card in front of a small bar chart
  `<ellipse class="tr-shadow" cx="50" cy="88" rx="32" ry="3"/>
   <rect class="tr-pp" x="34" y="17" width="52" height="56" rx="3"/>
   <path class="tr-ln" d="M42 26h13"/><path class="tr-fn" d="M42 36h36M42 48h36M42 64h36"/>
   <rect class="tr-tn" x="57" y="48" width="6" height="16" rx="1.5"/><rect class="tr-tn" x="66" y="39" width="6" height="25" rx="1.5"/><rect class="tr-k" x="75" y="30" width="6" height="34" rx="1.5"/>
   <rect class="tr-tn" x="12" y="54" width="44" height="28" rx="3"/>
   <rect class="tr-pp" x="18" y="60" width="9" height="7" rx="1.5"/><path class="tr-ln" d="M18 75h7M29 75h7M40 75h4"/>`,
  // Testing AI: a magnifier with a tick, checking a chat bubble
  `<ellipse class="tr-shadow" cx="50" cy="88" rx="32" ry="3"/>
   <g transform="translate(0 4)"><path class="tr-pp" d="M23 17h40a10 10 0 0 1 10 10v20a10 10 0 0 1-10 10H35l-9 8.5V57h-3a10 10 0 0 1-10-10V27a10 10 0 0 1 10-10Z"/>
   <path class="tr-ln" d="M23 29h30M23 37h22M23 45h14"/>
   <rect class="tr-tn" x="79" y="56.5" width="16" height="7" rx="3" transform="rotate(45 66 60)"/>
   <circle class="tr-pp" cx="66" cy="60" r="15"/><path class="tr-fn" d="M56.5 54.5a10.5 10.5 0 0 1 7-5.6"/>
   <path class="tr-tick" d="M60 60.5l4.2 4.2 8.3-8.4"/></g>`,
  // Shipping agents: a hub with an AI spark, linked to three tools (a document, a terminal, a shield with a tick)
  `<ellipse class="tr-shadow" cx="48" cy="88" rx="32" ry="3"/>
   <path class="tr-ln" d="M46 48 21 20M46 48 19 73M46 48 80 74"/>
   <path class="tr-pp" d="M14 11h9.5l5.5 5.5V30a2.5 2.5 0 0 1-2.5 2.5h-12.5a2.5 2.5 0 0 1-2.5-2.5V13.5a2.5 2.5 0 0 1 2.5-2.5Z"/><path class="tr-ln" d="M23.5 11v5.5h5.5"/><path class="tr-fn" d="M15.5 22h9M15.5 26.5h6.5"/>
   <rect class="tr-pp" x="7" y="65" width="23" height="17" rx="3"/><path class="tr-ln" d="M12 70.5l3.2 3-3.2 3M18.5 77h6"/>
   <path class="tr-pp" d="M80 63.5l8.5 3.2v6.8c0 5.6-3.7 9.2-8.5 11-4.8-1.8-8.5-5.4-8.5-11v-6.8Z"/><path class="tr-ln" d="M76.3 73.6l2.6 2.6 4.8-5"/>
   <rect class="tr-tn" x="30" y="32" width="32" height="32" rx="10"/>
   <path class="tr-k" d="M44.5 39.5Q45.9 48.6 55 50 45.9 51.4 44.5 60.5 43.1 51.4 34 50 43.1 48.6 44.5 39.5Z"/>
   <path class="tr-k tr-twinkle" d="M55 36Q55.5 39.5 59 40 55.5 40.5 55 44 54.5 40.5 51 40 54.5 39.5 55 36Z"/>`,
];
---
<div class="tr" data-reveal style={vars}>
  <style is:inline set:html={css}></style>
  <span class="tr-start" aria-hidden="true"></span>
  <span class="tr-line" aria-hidden="true"><svg class="tr-h" viewBox={`0 0 ${H.len} ${2 * H.c}`} preserveAspectRatio="none" focusable="false"><path d={d(H, false)} /></svg><svg class="tr-v" viewBox={`0 0 ${2 * V.c} ${V.len}`} preserveAspectRatio="none" focusable="false"><path d={d(V, true)} /></svg></span>
  <ol class="tr-stops">
    {path.map((p, i) => (
      <li class="tr-stop" style={`--d:${at[i]}s`}>
        <span class="tr-art" aria-hidden="true">
          <svg viewBox="0 0 100 100" focusable="false" set:html={`<circle class="tr-disc" cx="50" cy="50" r="43"/>${art[i]}`} />
        </span>
        <div class="tr-txt">
          <h3>{p.title}</h3>
          <p>{p.line}</p>
        </div>
      </li>
    ))}
  </ol>
  {/* The traveller: a little paper plane (the same drawing as the one in Contact) that flies the trail once and lands by the agent hub. */}
  <span class="tr-fly" aria-hidden="true"><span class="tr-fx"><span class="tr-fy"><svg viewBox="0 0 40 30" focusable="false"><path d="M2 14 L38 2 L26 28 L18 18 Z" /><path d="M38 2 L18 18 L16 27 L22 21" /></svg></span></span></span>
</div>
