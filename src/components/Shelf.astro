---
// "On my shelf" on My corner, drawn in the desk's ink line style (1.5px grey ink, white and light-grey fills, one
// near-black accent, the desk's soft shadow). Real book proportions, titles on the spines as text, a metal bookend
// and a small plant; no covers, art or logos. Every book is a real <button> laid over the drawing that opens a note
// card exactly like the desk's (the page script in corner.astro runs it).
// The drawing is sized to the books: the group is centred on a plank just long enough for it, with the bookend and
// the plant close by. Add a book to `books` in src/data/corner.ts (one line) and the shelf draws it. Up to 8 books
// stand on one shelf on wide screens and up to 4 per shelf on phones (so spine text stays legible); when both come
// out the same (4 books or fewer) only one drawing is made.
import { books, whySoon } from '../data/corner';

type Look = { w: number; h: number; fill: 'paper' | 'tint' | 'ink'; spine?: string };
// Per-book look in drawing units (1 unit = 1 CSS px at the drawing's natural size). Unknown books get a default.
const looks: Record<string, Look> = {
  itc: { w: 36, h: 210, fill: 'paper', spine: 'SHELDON' },
  hp: { w: 40, h: 196, fill: 'tint', spine: 'ROWLING' },
  dm: { w: 34, h: 192, fill: 'ink', spine: 'CROUCH' },
  sp: { w: 34, h: 186, fill: 'paper', spine: 'MICHAELIDES' },
};
const fallback = (i: number): Look => ({ w: 32 + (i % 3) * 3, h: 180 + (i % 4) * 6, fill: i % 2 ? 'tint' : 'paper' });
const lookOf = (id: string, i: number) => looks[id] ?? fallback(i);

type Hit = { id: string; x: number; y: number; w: number; h: number };
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

// One spine: body, two faint bands top and bottom, the title reading top to bottom, the author's surname at the foot.
function spine(x: number, base: number, w: number, h: number, fill: string, title: string, foot?: string) {
  const y = base - h, cx = x + w / 2;
  const fs = w >= 34 ? 11.5 : 11;
  // Rough text lengths (in units) so the surname only goes on when it fits under the title.
  const tl = title.length * 0.56 * fs, fl = foot ? foot.length * 0.78 * 8.5 : 0;
  if (foot && 20 + tl + 12 + fl + 18 > h) foot = undefined;
  return `<rect class="bk-body bk-${fill}" x="${x}" y="${y}" width="${w}" height="${h}" rx="2.5"/>`
    + `<path class="bk-band" d="M${x + 3} ${y + 9}h${w - 6}M${x + 3} ${y + 12.5}h${w - 6}M${x + 3} ${base - 9}h${w - 6}M${x + 3} ${base - 12.5}h${w - 6}"/>`
    + `<text class="bk-t bk-t-${fill}" transform="translate(${cx} ${y + 20}) rotate(90)" dy="0.35em" font-size="${fs}">${esc(title)}</text>`
    + (foot ? `<text class="bk-a bk-t-${fill}" transform="translate(${cx} ${base - 18}) rotate(90)" dy="0.35em" text-anchor="end">${esc(foot)}</text>` : '');
}

function book(id: string, x: number, base: number) {
  const i = books.findIndex((q) => q.id === id), b = books[i], l = lookOf(id, i);
  return { svg: `<g class="bk" data-obj="${id}"><g class="bk-lift">${spine(x, base, l.w, l.h, l.fill, b.title, l.spine)}</g></g>`, hit: { id, x, y: base - l.h, w: l.w, h: l.h } as Hit, w: l.w };
}

const GAP = 4, END = 37, PLANT = 58, PLANT_GAP = 12, EDGE = 4, INSET = 12, ROW_H = 270, TOP = 236;
function bookend(x: number, base: number) {
  return `<g class="bk-end"><path class="bk-metal" d="M${x} ${base} V${base - 112} a3 3 0 0 1 3 -3 h3 V${base - 4} h30 a2 2 0 0 1 0 4 Z"/></g>`;
}
function plant(x: number, base: number) {
  // A small pot with a few leaves, in the same ink.
  return `<g class="sh-plant">`
    + `<path class="sh-leaf" d="M${x + 28} ${base - 44} C ${x + 10} ${base - 70}, ${x + 2} ${base - 92}, ${x + 8} ${base - 112} C ${x + 22} ${base - 96}, ${x + 30} ${base - 74}, ${x + 28} ${base - 44} Z"/>`
    + `<path class="sh-leaf" d="M${x + 30} ${base - 44} C ${x + 34} ${base - 78}, ${x + 44} ${base - 104}, ${x + 58} ${base - 116} C ${x + 60} ${base - 92}, ${x + 50} ${base - 66}, ${x + 30} ${base - 44} Z"/>`
    + `<path class="sh-leaf sh-leaf-t" d="M${x + 29} ${base - 44} C ${x + 20} ${base - 62}, ${x + 22} ${base - 80}, ${x + 30} ${base - 92} C ${x + 38} ${base - 78}, ${x + 38} ${base - 60}, ${x + 29} ${base - 44} Z"/>`
    + `<path class="sh-vein" d="M${x + 28} ${base - 46} C ${x + 18} ${base - 70}, ${x + 12} ${base - 90}, ${x + 9} ${base - 108}M${x + 31} ${base - 46} C ${x + 38} ${base - 74}, ${x + 46} ${base - 98}, ${x + 56} ${base - 113}"/>`
    + `<path class="sh-pot" d="M${x + 6} ${base - 44} H${x + 52} L${x + 46} ${base} H${x + 12} Z"/>`
    + `<path class="sh-rim" d="M${x + 3} ${base - 50} H${x + 55} V${base - 42} H${x + 3} Z"/>`
    + `</g>`;
}
function plank(x0: number, x1: number, base: number) {
  const leg = Math.min(56, (x1 - x0) / 5);
  return `<rect class="sh-shadow" x="${x0 + 18}" y="${base + 14}" width="${x1 - x0 - 36}" height="6" rx="3"/>`
    + `<rect class="sh-wood" x="${x0}" y="${base}" width="${x1 - x0}" height="12" rx="2"/>`
    + `<path class="sh-ink" d="M${x0 + leg} ${base + 12} v20 l20 -20M${x1 - leg} ${base + 12} v20 l-20 -20"/>`;
}

// Lays the books out in rows of at most `per`: each row is centred, books left to right with a small gap, then the
// bookend on the last row and the plant on the first; the plank is just long enough for the widest row.
function draw(per: number) {
  const ids = books.map((b) => b.id);
  const rows: string[][] = [];
  for (let k = 0; k < ids.length; k += per) rows.push(ids.slice(k, k + per));
  const booksW = (r: string[]) => r.reduce((a, id) => a + lookOf(id, ids.indexOf(id)).w, 0) + (r.length - 1) * GAP;
  const rowW = rows.map((r, n) => booksW(r) + (n === rows.length - 1 ? GAP + END : 0) + (n === 0 ? PLANT_GAP + PLANT : 0));
  const W = Math.max(...rowW) + 2 * (EDGE + INSET);
  let svg = '';
  const hits: Hit[] = [];
  rows.forEach((r, n) => {
    const base = TOP + n * ROW_H;
    svg += plank(EDGE, W - EDGE, base);
    let x = (W - rowW[n]) / 2;
    svg += `<rect class="sh-shadow" x="${x - 4}" y="${base - 4}" width="${booksW(r) + 8}" height="5" rx="2.5"/>`;
    r.forEach((id) => { const o = book(id, x, base); svg += o.svg; hits.push(o.hit); x += o.w + GAP; });
    if (n === rows.length - 1) { svg += bookend(x + 1, base); x += END; }
    if (n === 0) svg += plant(x + PLANT_GAP - (n === rows.length - 1 ? 0 : GAP), base);
  });
  return { W, H: TOP + (rows.length - 1) * ROW_H + 40, svg, hits, key: rows.map((r) => r.join()).join('|') };
}

const wide = draw(8), narrow = draw(4);
const layouts = wide.key === narrow.key ? [{ k: 'one', ...wide }] : [{ k: 'wide', ...wide }, { k: 'narrow', ...narrow }];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<div class="shf-draw" data-shelf>
  {layouts.map((L) => (
    <div class={`shf-art shf-${L.k}`} style={`--ar:${((L.H / L.W) * 100).toFixed(3)}%;--mw:${L.W}px`}>
      <svg class="shf-svg" width={L.W} height={L.H} viewBox={`0 0 ${L.W} ${L.H}`} aria-hidden="true" focusable="false" set:html={L.svg} />
      {L.hits.map((h) => {
        const b = books.find((q) => q.id === h.id)!;
        return (
          <button type="button" class="bk-hit" data-k={h.id} aria-expanded="false" aria-controls="sh-card"
            style={`left:${pct(h.x - 3, L.W)};top:${pct(h.y - 6, L.H)};width:${pct(h.w + 6, L.W)};height:${pct(h.h + 10, L.H)}`}>
            <span class="sr-only">{b.title}{b.series ? ' (the series)' : ''} by {b.author}</span>
          </button>
        );
      })}
    </div>
  ))}
  <template id="sh-notes">{books.map((b) => <div data-k={b.id} data-name={b.title} data-by={b.author} data-note={b.why || whySoon} data-soon={b.why ? undefined : ''} />)}</template>
</div>
