---
// Shared favicon and link-preview tags. Put inside <head>, after <title> and the description.
interface Props { title: string; description: string; path?: string; md?: string | false }
const { title, description, path = '/' } = Astro.props;
// Plain-markdown twin of this page for AI agents and screeners (built by src/lib/markdown.ts).
const md = Astro.props.md ?? (path === '/' ? '/index.md' : path.replace(/\/$/, '') + '.md');
const abs = (p: string) => new URL(p, Astro.site).href;
---
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={abs(path)} />
{md && <link rel="alternate" type="text/markdown" href={md} title="This page as markdown" />}
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
<meta name="theme-color" content="#0b0b0c" />
<meta name="author" content="Nityashree S" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Nityashree S" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(path)} />
<meta property="og:image" content={abs('/og.png')} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Nityashree S, AI engineer. I build AI agents people can trust." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={abs('/og.png')} />
