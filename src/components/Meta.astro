---
// Shared favicon and link-preview tags. Put inside <head>, after <title> and the description.
interface Props { title: string; description: string; path?: string }
const { title, description, path = '/' } = Astro.props;
---
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0b0b0c" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/headshot.png" />
<meta property="og:url" content={path} />
<meta name="twitter:card" content="summary" />
