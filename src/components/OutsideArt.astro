---
// Small illustrated animations for the "When I'm not working" cards. Inline SVG + CSS only:
// ink lines on the warm card, one green accent. They play only while the list is on screen
// (the page adds .in to .ow-list) and stand still for prefers-reduced-motion.
interface Props { kind: 'read' | 'dance' | 'yoga' | 'stage' | 'globe' }
const { kind } = Astro.props;
---
<svg class:list={['oa', `oa-${kind}`]} viewBox="0 0 200 110" aria-hidden="true" focusable="false">
  {kind === 'read' && (
    <g fill="none" stroke-linejoin="round" stroke-linecap="round">
      <path class="oa-soft" d="M100 30 C84 24 64 24 46 28 V86 C64 82 84 82 100 88 Z" />
      <path class="oa-soft" d="M100 30 C116 24 136 24 154 28 V86 C136 82 116 82 100 88 Z" />
      <path class="oa-ln" d="M56 42 H88 M56 52 H90 M56 62 H86 M112 42 H144 M112 52 H140 M112 62 H144" />
      <path class="oa-page" d="M100 30 C116 24 136 24 154 28 V86 C136 82 116 82 100 88 Z" />
      <path class="oa-ink" d="M100 30 V88" />
      <path class="oa-accent-stroke" d="M138 22 V40 L142 36 L146 40 V22" />
    </g>
  )}
  {kind === 'dance' && (
    <g fill="none" stroke-linecap="round">
      <path class="oa-swirl oa-s1" pathLength="100" d="M24 78 C48 30 78 30 92 56 S124 92 138 60 S168 22 182 40" />
      <path class="oa-swirl oa-s2" pathLength="100" d="M30 60 C54 92 76 84 90 66 S118 26 140 40 S170 82 186 70" />
      <circle class="oa-dot" r="4" cx="0" cy="0" />
    </g>
  )}
  {kind === 'yoga' && (
    <g fill="none">
      <circle class="oa-ring" cx="100" cy="55" r="42" />
      <circle class="oa-ring oa-r2" cx="100" cy="55" r="32" />
      <circle class="oa-breath" cx="100" cy="55" r="22" />
      <circle class="oa-core" cx="100" cy="55" r="4" />
    </g>
  )}
  {kind === 'stage' && (
    <g>
      <defs>
        <linearGradient id="oa-beam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3f7a4c" stop-opacity="0.04" /><stop offset="1" stop-color="#3f7a4c" stop-opacity="0.22" /></linearGradient>
      </defs>
      <path class="oa-floor" d="M20 96 H180" />
      <g class="oa-spot"><path d="M100 4 L74 96 H126 Z" fill="url(#oa-beam)" /><ellipse cx="100" cy="96" rx="26" ry="4" class="oa-pool" /></g>
      <circle cx="100" cy="4" r="4" class="oa-lamp" />
      <g class="oa-mic" fill="none" stroke-linecap="round">
        <rect x="93" y="48" width="14" height="22" rx="7" />
        <path d="M89 62 C89 72 111 72 111 62 M100 72 V92 M90 92 H110" />
      </g>
    </g>
  )}
  {kind === 'globe' && (
    <g fill="none" stroke-linecap="round">
      <circle class="oa-soft" cx="100" cy="58" r="40" />
      <ellipse class="oa-ln oa-mer" cx="100" cy="58" rx="16" ry="40" />
      <ellipse class="oa-ln oa-mer oa-m2" cx="100" cy="58" rx="30" ry="40" />
      <path class="oa-ln" d="M60 58 H140 M66 38 H134 M66 78 H134" />
      <path class="oa-arc" pathLength="100" d="M78 74 C84 22 118 18 128 46" />
      <circle class="oa-pin" cx="78" cy="74" r="4" />
      <circle class="oa-pin oa-p2" cx="128" cy="46" r="4" />
    </g>
  )}
</svg>
