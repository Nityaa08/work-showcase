---
import { cases } from '../data/cases';
interface Props { slug: string }
const { slug } = Astro.props;
const ready = cases.filter((c) => c.ready);
const i = ready.findIndex((c) => c.slug === slug);
const prev = ready[i - 1];
const next = ready[i + 1];
---
<footer class="case-nav">
  {prev ? (
    <a class="cn prev" href={`/work/${prev.slug}/`}>
      <span class="cn-btn" aria-hidden="true">←</span>
      <span class="cn-meta"><em>Previous · Case {prev.no}</em><b>{prev.title}</b></span>
    </a>
  ) : (
    <a class="cn prev" href="/#work">
      <span class="cn-btn" aria-hidden="true">←</span>
      <span class="cn-meta"><em>All work</em><b>Back to the overview</b></span>
    </a>
  )}
  {next ? (
    <a class="cn next" href={`/work/${next.slug}/`}>
      <span class="cn-meta"><em>Next · Case {next.no}</em><b>{next.title}</b></span>
      <span class="cn-btn" aria-hidden="true">→</span>
    </a>
  ) : (
    <a class="cn next" href="/#work">
      <span class="cn-meta"><em>That’s all three</em><b>Back to all work</b></span>
      <span class="cn-btn" aria-hidden="true">↑</span>
    </a>
  )}
</footer>
