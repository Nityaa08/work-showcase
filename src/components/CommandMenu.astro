---
// A small command menu: Cmd+K / Ctrl+K or "/" opens it, and so does the button in the nav (for touch screens).
// An accessible dialog with a filterable list (combobox + listbox): arrows move, Enter opens, Esc closes and focus
// returns to where it was. Vanilla JS, no framework. Copy lives in src/data/menu.ts.
import { getMenuItems, menuCopy } from '../data/menu';
import { getNotes } from '../lib/notes';
const menuItems = getMenuItems((await getNotes()).length > 0);
const groups = [...new Set(menuItems.map((m) => m.group))];
---
<div class="cmdk" id="cmdk" role="dialog" aria-modal="true" aria-labelledby="cmdk-title" hidden>
  <div class="cmdk-scrim" data-cmdk-close></div>
  <div class="cmdk-panel">
    <h2 class="sr-only" id="cmdk-title">{menuCopy.title}</h2>
    <div class="cmdk-bar">
      <svg class="cmdk-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      <label class="sr-only" for="cmdk-input">{menuCopy.placeholder}</label>
      <input class="cmdk-input" id="cmdk-input" type="text" role="combobox" aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={menuCopy.placeholder} />
      <button type="button" class="cmdk-x" data-cmdk-close aria-label="Close menu"><kbd>Esc</kbd><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
    </div>
    <div class="cmdk-list" id="cmdk-list" role="listbox" aria-label={menuCopy.title}>
      {groups.map((g, gi) => (
        <div class="cmdk-group" role="group" aria-labelledby={`cmdk-g${gi}`}>
          <p class="cmdk-gh" id={`cmdk-g${gi}`} aria-hidden="true">{g}</p>
          {menuItems.filter((m) => m.group === g).map((m) => (
            <div class="cmdk-opt" role="option" id={`cmdk-${m.id}`} aria-selected="false"
              data-href={m.href} data-new={m.newTab ? '1' : undefined} data-download={m.download ? '1' : undefined}
              data-text={`${m.label} ${m.hint} ${m.keys}`.toLowerCase()}>
              <span class="cmdk-l">{m.label}</span>
              <span class="cmdk-h">{m.hint}{m.newTab && <span aria-hidden="true"> ↗</span>}</span>
            </div>
          ))}
        </div>
      ))}
      <p class="cmdk-empty" hidden>{menuCopy.empty}</p>
    </div>
    <p class="cmdk-foot" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> {menuCopy.footer.move}</span><span><kbd>↵</kbd> {menuCopy.footer.open}</span><span><kbd>Esc</kbd> {menuCopy.footer.close}</span></p>
    <p class="sr-only" id="cmdk-live" role="status" aria-live="polite"></p>
  </div>
</div>
<script>
  const root = document.getElementById('cmdk');
  const trigger = document.getElementById('cmdk-btn');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('.cmdk-input')!;
    const list = root.querySelector<HTMLElement>('.cmdk-list')!;
    const opts = [...root.querySelectorAll<HTMLElement>('[role="option"]')];
    const groupEls = [...root.querySelectorAll<HTMLElement>('.cmdk-group')];
    const empty = root.querySelector<HTMLElement>('.cmdk-empty')!;
    const live = root.querySelector<HTMLElement>('#cmdk-live')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('.cmdk-x')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const mac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
    let isOpen = false, active = -1, back: HTMLElement | null = null, timer = 0;

    if (trigger) {
      trigger.hidden = false;
      document.getElementById('nav')?.classList.add('has-menu');
      const k = trigger.querySelector('.cmdk-kbd');
      if (k) k.textContent = mac ? '⌘K' : 'Ctrl K';
      trigger.setAttribute('aria-keyshortcuts', mac ? 'Meta+K /' : 'Control+K /');
      trigger.addEventListener('click', () => open());
    }

    const shown = () => opts.filter((o) => !o.hidden);
    const setActive = (i: number, scroll = true) => {
      const v = shown();
      opts.forEach((o) => o.setAttribute('aria-selected', 'false'));
      if (!v.length) { active = -1; input.removeAttribute('aria-activedescendant'); return; }
      active = (i + v.length) % v.length;
      const o = v[active];
      o.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', o.id);
      if (scroll) o.scrollIntoView({ block: 'nearest' });
    };
    const filter = () => {
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      opts.forEach((o) => { o.hidden = !words.every((w) => o.dataset.text!.includes(w)); });
      groupEls.forEach((g) => { g.hidden = !g.querySelector('[role="option"]:not([hidden])'); });
      const n = shown().length;
      empty.hidden = n > 0;
      setActive(0);
      live.textContent = words.length ? (n ? `${n} ${n === 1 ? 'result' : 'results'}` : empty.textContent!) : '';
    };

    function open() {
      if (isOpen) return;
      isOpen = true; clearTimeout(timer);
      back = document.activeElement as HTMLElement | null;
      // Keep the page from scrolling behind the menu, without a jump where a scrollbar disappears.
      const bar = innerWidth - document.documentElement.clientWidth;
      document.documentElement.classList.add('cmdk-lock');
      if (bar > 0) document.documentElement.style.paddingRight = `${bar}px`;
      input.value = ''; filter();
      root!.hidden = false;
      trigger?.setAttribute('aria-expanded', 'true');
      input.focus({ preventScroll: true });
      requestAnimationFrame(() => requestAnimationFrame(() => { if (isOpen) root!.classList.add('on'); }));
    }
    function close(restore = true) {
      if (!isOpen) return;
      isOpen = false;
      root!.classList.remove('on');
      trigger?.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('cmdk-lock');
      document.documentElement.style.paddingRight = '';
      live.textContent = '';
      timer = window.setTimeout(() => { root!.hidden = true; }, still.matches ? 0 : 200);
      if (restore && back && document.contains(back)) back.focus({ preventScroll: true });
    }
    function go(o: HTMLElement) {
      const href = o.dataset.href!;
      const url = new URL(href, location.href);
      // A section of the page we're already on: scroll there and move focus to it.
      if (url.protocol.startsWith('http') && url.origin === location.origin && url.pathname === location.pathname && url.hash) {
        const t = document.querySelector<HTMLElement>(url.hash);
        close(false);
        if (t) {
          if (!t.hasAttribute('tabindex')) t.setAttribute('tabindex', '-1');
          t.scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth', block: 'start' });
          t.focus({ preventScroll: true });
          history.pushState(null, '', url.hash);
        }
        return;
      }
      const a = document.createElement('a');
      a.href = href;
      if (o.dataset.new) { a.target = '_blank'; a.rel = 'noopener'; }
      if (o.dataset.download) a.setAttribute('download', '');
      const leaves = !o.dataset.new && !o.dataset.download && !href.startsWith('mailto:');
      close(!leaves);
      document.body.append(a); a.click(); a.remove();
    }

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Home' && !input.value) { e.preventDefault(); setActive(0); }
      else if (e.key === 'End' && !input.value) { e.preventDefault(); setActive(-1); }
      else if (e.key === 'Enter') { e.preventDefault(); const o = shown()[active]; if (o) go(o); }
    });
    opts.forEach((o) => {
      o.addEventListener('pointermove', () => { const i = shown().indexOf(o); if (i !== active) setActive(i, false); });
      o.addEventListener('click', () => go(o));
    });
    // Clicking inside the panel must not move focus off the search field (the combobox keeps it).
    root.addEventListener('mousedown', (e) => { if (!(e.target as Element).closest('input, button, [data-cmdk-close]')) e.preventDefault(); });
    root.querySelectorAll('[data-cmdk-close]').forEach((el) => el.addEventListener('click', () => close()));

    // Window, capture phase: runs before the page's own Escape handlers (the desk's note), so Esc closes only the menu.
    addEventListener('keydown', (e) => {
      const k = e.key;
      if ((e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey && (k === 'k' || k === 'K')) {
        e.preventDefault(); isOpen ? close() : open(); return;
      }
      if (isOpen) {
        if (k === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); close(); return; }
        if (k === 'Tab') {
          // Focus stays inside the menu: the search field and the close button.
          e.preventDefault();
          (document.activeElement === input ? closeBtn : input).focus();
        }
        return;
      }
      if (k === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const t = e.target as HTMLElement;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        e.preventDefault(); open();
      }
    }, true);
  }
</script>
