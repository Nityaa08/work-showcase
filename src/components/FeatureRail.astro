---
import FeatureDemo from './FeatureDemo.astro';
import type { Feature } from '../data/cases';
interface Props { features: Feature[] }
const { features } = Astro.props;
---
<section class="rail-sec" id="ch-features">
  <div class="story-head rail-head"><p class="kicker">What the platform does</p><h2>What agents can do on it.</h2></div>
  <div class="rail">
    <div class="acc">
      <ol class="rail-list">
        {features.map((f, n) => (
          <li class:list={['rail-item', { on: n === 0 }]} data-i={n}>
            <button type="button" aria-expanded={n === 0 ? 'true' : 'false'}>
              <span class="r-name">{f.name}</span>
              <svg class="chev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
            </button>
            <div class="r-more"><div><p>{f.text}</p><span class="r-bar"><i /></span></div></div>
          </li>
        ))}
      </ol>
    </div>
    <div class="rail-stage">
      <div class="rail-frame">
        {features.map((f, n) => <div class:list={['rail-slot', { on: n === 0 }]} data-i={n}><FeatureDemo kind={f.demo} manual /></div>)}
      </div>
    </div>
  </div>
</section>
<script>
  const items = [...document.querySelectorAll<HTMLElement>('.rail-item')];
  const slots = [...document.querySelectorAll<HTMLElement>('.rail-slot')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEP = 1700, HOLD = 2800;
  let current = 0, run = 0, inView = false;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function show(i: number) {
    const me = ++run;
    current = i;
    items.forEach((el, n) => { el.classList.toggle('on', n === i); el.querySelector('button')!.setAttribute('aria-expanded', String(n === i)); });
    slots.forEach((el, n) => el.classList.toggle('on', n === i));
    fit();
    const demo = slots[i].querySelector<HTMLElement>('[data-demo]')!;
    const steps = Number(demo.dataset.steps);
    const bar = items[i].querySelector<HTMLElement>('.r-bar i')!;
    if (reduced) { demo.dataset.step = String(steps - 1); return; }
    const total = (steps - 1) * STEP + HOLD;
    bar.style.transition = 'none'; bar.style.transform = 'scaleX(0)'; void bar.offsetWidth;
    bar.style.transition = `transform ${total}ms linear`; bar.style.transform = 'scaleX(1)';
    for (let s = 0; s < steps; s++) {
      if (me !== run) return;
      demo.dataset.step = String(s);
      await sleep(s === steps - 1 ? HOLD : STEP);
    }
    if (me === run && inView) show((i + 1) % items.length);
  }
  // Every description reserves the height of the longest one, so opening a feature never moves the list or the demo.
  const list = document.querySelector<HTMLElement>('.rail-list')!;
  const reserve = () => {
    list.style.removeProperty('--rail-d');
    list.style.setProperty('--rail-d', `${Math.max(...items.map((el) => el.querySelector<HTMLElement>('.r-more p')!.offsetHeight))}px`);
  };
  reserve(); addEventListener('resize', reserve); document.fonts?.ready.then(reserve);

  // Each demo gets its own height: the tallest it reaches across its steps (bottom-pinned toasts and banners included).
  // Side by side (desktop), the frame eases to the open demo's height and stays centred in a box as tall as the tallest
  // demo, moved by transform only, so the list and the page never shift. Stacked (tablets), every demo uses the tallest
  // height. On phones (700px and under) the CSS keeps its own rule: the window grows to hold the tallest finished state.
  const stage = document.querySelector<HTMLElement>('.rail-stage')!;
  const heights: number[] = [];
  const sideBySide = matchMedia('(min-width: 961px)'), phone = matchMedia('(max-width: 700px)');
  const natural = (demo: HTMLElement) => {
    const body = demo.querySelector<HTMLElement>('.demo-body')!;
    const bar = demo.querySelector<HTMLElement>('.demo-bar')!;
    const keep = demo.dataset.step!;
    const pad = parseFloat(getComputedStyle(body).paddingBottom);
    let need = 0;
    demo.classList.add('measuring');
    for (let s = 0; s < Number(demo.dataset.steps); s++) {
      demo.dataset.step = String(s);
      const top = body.getBoundingClientRect().top;
      let flow = 0, pinned = 0;
      for (const el of body.querySelectorAll<HTMLElement>(':scope > *')) {
        const cs = getComputedStyle(el);
        if (cs.display === 'none' || el.classList.contains('pointer')) continue;
        const r = el.getBoundingClientRect();
        if (el.matches('.toast:not(.t-top), .banner')) pinned = Math.max(pinned, r.height + parseFloat(cs.bottom) + 12);
        else flow = Math.max(flow, r.bottom - top + parseFloat(cs.marginBottom || '0'));
      }
      need = Math.max(need, flow + (pinned || pad));
    }
    demo.dataset.step = keep;
    void demo.offsetHeight; // settle the restored step while transitions are still off, so nothing animates back
    demo.classList.remove('measuring');
    return Math.ceil(bar.offsetHeight + need + 2);
  };
  function fit() {
    if (phone.matches) { stage.style.removeProperty('--stage-max'); stage.style.removeProperty('--stage-h'); return; }
    if (!heights.length) return;
    const max = Math.max(...heights);
    stage.style.setProperty('--stage-max', `${max}px`);
    stage.style.setProperty('--stage-h', `${sideBySide.matches ? heights[current] : max}px`);
  }
  const measure = () => {
    stage.classList.add('measuring');
    slots.forEach((el, n) => (heights[n] = natural(el.querySelector<HTMLElement>('[data-demo]')!)));
    void stage.offsetHeight;
    stage.classList.remove('measuring');
    fit();
  };
  measure(); addEventListener('resize', measure); document.fonts?.ready.then(measure);
  items.forEach((el, n) => el.querySelector('button')!.addEventListener('click', () => show(n)));
  new IntersectionObserver(([e]) => {
    inView = e.isIntersecting;
    if (inView) show(current); else run++;
  }, { threshold: 0.35 }).observe(document.querySelector('.rail')!);
</script>
