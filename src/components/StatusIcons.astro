---
interface Props { kind: 'ios' | 'mac' }
const { kind } = Astro.props;
---
{kind === 'ios' ? (
  <span class="sicons" aria-hidden="true">
    <svg width="17" height="11" viewBox="0 0 17 11"><rect x="0" y="7" width="3" height="4" rx="1" fill="currentColor"/><rect x="4.5" y="5" width="3" height="6" rx="1" fill="currentColor"/><rect x="9" y="2.5" width="3" height="8.5" rx="1" fill="currentColor"/><rect x="13.5" y="0" width="3" height="11" rx="1" fill="currentColor"/></svg>
    <svg width="15" height="11" viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.9 5.7 2.3l1.1-1.1C12.5 1.6 10.1.6 7.5.6S2.5 1.6.7 3.4l1.1 1.1C3.3 3.1 5.3 2.2 7.5 2.2Z" fill="currentColor"/><path d="M7.5 5.3c1.4 0 2.6.5 3.5 1.4l1.1-1.1C10.9 4.4 9.3 3.7 7.5 3.7S4.1 4.4 2.9 5.6L4 6.7c.9-.9 2.1-1.4 3.5-1.4Z" fill="currentColor"/><path d="M7.5 8.3c.6 0 1.1.2 1.5.6L7.5 10.4 6 8.9c.4-.4.9-.6 1.5-.6Z" fill="currentColor"/></svg>
    <svg width="25" height="12" viewBox="0 0 25 12"><rect x="0.5" y="0.5" width="21" height="11" rx="3.5" stroke="currentColor" opacity="0.4" fill="none"/><rect x="2" y="2" width="16" height="8" rx="2" fill="currentColor"/><path d="M23 4v4c.8-.3 1.4-1.1 1.4-2s-.6-1.7-1.4-2Z" fill="currentColor" opacity="0.4"/></svg>
  </span>
) : (
  <span class="sicons" aria-hidden="true">
    <svg width="14" height="10" viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.9 5.7 2.3l1.1-1.1C12.5 1.6 10.1.6 7.5.6S2.5 1.6.7 3.4l1.1 1.1C3.3 3.1 5.3 2.2 7.5 2.2Z" fill="currentColor"/><path d="M7.5 5.3c1.4 0 2.6.5 3.5 1.4l1.1-1.1C10.9 4.4 9.3 3.7 7.5 3.7S4.1 4.4 2.9 5.6L4 6.7c.9-.9 2.1-1.4 3.5-1.4Z" fill="currentColor"/><path d="M7.5 8.3c.6 0 1.1.2 1.5.6L7.5 10.4 6 8.9c.4-.4.9-.6 1.5-.6Z" fill="currentColor"/></svg>
    <svg width="22" height="10" viewBox="0 0 25 12"><rect x="0.5" y="0.5" width="21" height="11" rx="3.5" stroke="currentColor" opacity="0.5" fill="none"/><rect x="2" y="2" width="14" height="8" rx="2" fill="currentColor"/></svg>
    <span class="mac-clock" data-clock="mac">--</span>
  </span>
)}
